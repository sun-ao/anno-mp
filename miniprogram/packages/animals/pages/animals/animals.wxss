.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #C8E6C9 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip {
  font-size: 30rpx;
  color: #388E3C;
  font-weight: 600;
  margin-bottom: 48rpx;
}

.grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 31%;
  aspect-ratio: 1 / 1;
  margin-bottom: 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.12s ease;
}

.card-hover {
  transform: scale(0.96);
}

.card-active {
  background: #FFF8E1;
  box-shadow: 0 8rpx 22rpx rgba(255, 179, 0, 0.35);
  transform: scale(1.04);
}

.emoji {
  font-size: 96rpx;
  line-height: 1.2;
}

.name {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #558B2F;
}
