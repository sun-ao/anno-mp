<view class="page">
  <view class="count-panel">
    <view class="count-main">
      <text class="count-num">{{poppedCount}}</text>
      <text class="count-label">吹爆的气球</text>
    </view>
    <view class="count-clear" bindtap="onClear">清空</view>
  </view>

  <view class="gauge">
    <view
      class="gauge-fill {{danger ? 'gauge-fill-danger' : (risk > 0.5 ? 'gauge-fill-warn' : 'gauge-fill-ok')}}"
      style="width: {{risk * 100}}%;"
    ></view>
  </view>
  <view class="warn-text {{danger ? 'show' : ''}}">⚠️ 快炸啦，松手！</view>

  <view class="balloon-area" bindtouchstart="onInflateStart" bindtouchend="onInflateEnd" bindtouchcancel="onInflateEnd">
    <view
      wx:if="{{!popped}}"
      class="balloon {{danger ? 'balloon-danger' : ''}}"
      style="{{flying ? flyStyle : ('transform: scale(' + size + ');')}}"
    >🎈</view>
    <view wx:if="{{popped}}" class="boom">💥</view>
  </view>

  <view class="tip">{{holding ? (danger ? '松手！要炸了！' : '继续吹，松手放飞') : (flying ? '飞走啦～' : '按住屏幕给气球打气')}}</view>
</view>
