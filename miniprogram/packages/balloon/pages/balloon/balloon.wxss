.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFEBEE 0%, #FDD9DE 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.count-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.count-main {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.count-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #D9455F;
}

.count-label {
  font-size: 24rpx;
  color: #C98A95;
}

.count-clear {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #D9455F;
  background: #FFF0F3;
  border: 2rpx solid #F6C9D2;
  border-radius: 999rpx;
}

.count-clear:active {
  background: #F6C9D2;
}

/* 充气压力表：绿→黄→红，给“快炸”明确提示 */
.gauge {
  margin-top: 36rpx;
  width: 70%;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.gauge-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.05s linear, background 0.2s;
}

.gauge-fill-ok { background: #6BCB77; }
.gauge-fill-warn { background: #FFC93C; }
.gauge-fill-danger { background: #FF4D4F; }

.gauge-danger {
  animation: gaugePulse 0.4s infinite;
}

@keyframes gaugePulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

.warn-text {
  margin-top: 14rpx;
  height: 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #FF4D4F;
  opacity: 0;
}

.warn-text.show {
  opacity: 1;
  animation: warnShake 0.3s infinite;
}

@keyframes warnShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-6rpx); }
  75% { transform: translateX(6rpx); }
}

.balloon-area {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.balloon {
  font-size: 180rpx;
  line-height: 1;
  transition: transform 0.05s linear;
}

/* 临近爆炸：红色光晕 + 呼吸，不再靠“凭感觉” */
.balloon-danger {
  filter: drop-shadow(0 0 14rpx #FF4D4F);
  animation: dangerGlow 0.3s infinite alternate;
}

@keyframes dangerGlow {
  from { filter: drop-shadow(0 0 8rpx #FF4D4F); }
  to { filter: drop-shadow(0 0 22rpx #FF4D4F); }
}

/* 放飞：方向/时长由内联 --dx/--dy/--rot/--s 决定，可到处飞 */
@keyframes balloonFly {
  from {
    transform: scale(var(--s, 1)) translate(0, 0) rotate(0deg);
    opacity: 1;
  }
  to {
    transform: scale(calc(var(--s, 1) * 0.4)) translate(var(--dx, 0), var(--dy, 0)) rotate(var(--rot, 0deg));
    opacity: 0;
  }
}

.boom {
  font-size: 220rpx;
  line-height: 1;
  animation: boomIn 0.6s ease forwards;
}

@keyframes boomIn {
  0% { transform: scale(0.2); opacity: 0; }
  40% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(1); opacity: 0.9; }
}

.tip {
  font-size: 28rpx;
  color: #C06A7A;
  font-weight: 600;
}
