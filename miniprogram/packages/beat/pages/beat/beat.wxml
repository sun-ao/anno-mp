<view class="page">
  <view class="hud">
    <text class="hud-item">分数 {{score}}</text>
    <text class="hud-item">连击 {{combo}}</text>
    <text class="hud-item">最佳 {{best}}</text>
    <view class="score-clear" bindtap="onClear">清空最佳</view>
  </view>

  <view class="court"
    style="width:{{courtW}}rpx;height:{{courtH}}rpx"
    bindtap="onTap">

    <view class="line" style="top:{{lineY}}rpx"></view>

    <view class="note"
      wx:for="{{notes}}"
      wx:key="id"
      style="left:{{courtW/2 - 34}}rpx;top:{{item.y}}rpx;width:{{noteD}}rpx;height:{{noteD}}rpx">
      {{item.label}}
    </view>
  </view>

  <view class="actions">
    <view class="btn" bindtap="onTap">敲击</view>
    <view class="btn btn-ghost" bindtap="onAgain">重置</view>
  </view>

  <view class="tip">节拍点落到白线时，点「敲击」或点屏幕，越准连击越高</view>
</view>
