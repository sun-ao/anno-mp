.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E6F4FE 0%, #D2EBFB 100%);
  position: relative;
  overflow: hidden;
}

.counter {
  position: absolute;
  top: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 20rpx 64rpx;
  z-index: 10;
}

.counter-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #2B7CD3;
}

.counter-label {
  font-size: 24rpx;
  color: #7FA8CE;
}

.bubble-zone {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
}

.bubble-wrap {
  position: absolute;
  bottom: -180rpx;
}

.bubble-float {
  animation-name: floatUp;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
}

@keyframes floatUp {
  from { transform: translateY(0); }
  to { transform: translateY(-120vh); }
}

.bubble-body {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  box-sizing: border-box;
}

.bubble-shine {
  position: absolute;
  top: 16%;
  left: 18%;
  width: 26%;
  height: 20%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  transform: rotate(-30deg);
}

.bubble-pop {
  animation: bubblePop 0.28s ease forwards;
}

@keyframes bubblePop {
  from { transform: scale(1); opacity: 1; }
  to { transform: scale(1.6); opacity: 0; }
}

.tip {
  position: absolute;
  bottom: 48rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: #6C97BE;
  z-index: 10;
}

.score-clear {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
