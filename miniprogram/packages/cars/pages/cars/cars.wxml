<view class="page">
  <view class="title-area">
    <text class="title">工程车按钮台</text>
    <text class="subtitle">按一按，车车会响哦</text>
  </view>

  <scroll-view scroll-y class="car-scroll" enhanced show-scrollbar="{{false}}">
    <view class="car-grid">
      <view
        wx:for="{{vehicles}}"
        wx:key="name"
        class="car {{activeIndex === index ? 'car-bounce' : ''}}"
        data-idx="{{index}}"
        bindtap="onTapVehicle"
      >
        <text class="car-emoji">{{item.emoji}}</text>
        <text class="car-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>
</view>
