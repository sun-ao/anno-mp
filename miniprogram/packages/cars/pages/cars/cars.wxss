.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFF4E0 0%, #FFE9CF 100%);
  padding: 48rpx 32rpx 0;
  box-sizing: border-box;
}

.title-area {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #8A5A1B;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #C08A4A;
}

.car-scroll {
  flex: 1;
  margin-top: 56rpx;
  overflow: hidden;
  -webkit-overflow-scrolling: touch;
}

.car-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
  padding-bottom: 60rpx;
}

.car {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.07);
}

.car-emoji {
  font-size: 130rpx;
  line-height: 1.1;
}

.car-name {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #8A5A1B;
}

.car:active {
  transform: scale(0.96);
}

.car-bounce {
  animation: carBounce 0.5s ease;
}

@keyframes carBounce {
  0% { transform: scale(1); }
  35% { transform: scale(1.15) translateY(-12rpx); }
  65% { transform: scale(0.96) translateY(0); }
  100% { transform: scale(1); }
}
