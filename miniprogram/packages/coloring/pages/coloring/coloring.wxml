<view class="page">
  <view class="title-area">
    <view class="title">涂色书</view>
    <view class="subtitle">选个颜色，点圆圈涂一涂 🎨</view>
  </view>
  <view class="counter">画好 {{count}} 幅</view>
  <view class="score-clear" bindtap="onClear">清空</view>
  <view class="pattern-nav">
    <view class="nav-btn" bindtap="onPrev">‹</view>
    <view class="pattern-name">{{patternName}}（{{patternIndex + 1}}/{{patternTotal}}）</view>
    <view class="nav-btn" bindtap="onNext">›</view>
  </view>
  <view class="canvas">
    <view wx:for="{{regions}}" wx:key="id"
      class="region"
      style="left:{{item.x}}rpx; top:{{item.y}}rpx; width:{{item.size}}rpx; height:{{item.size}}rpx; border-radius:{{item.radius}}; background:{{item.color}}"
      data-id="{{item.id}}" bindtap="onTapRegion"></view>
    <view wx:if="{{done}}" class="done-mask">
      <view class="done-text">🌟 画好啦！</view>
      <view class="again-btn" bindtap="onAgain">再画一张</view>
    </view>
  </view>
  <view class="palette">
    <view wx:for="{{palette}}" wx:key="*this"
      class="swatch {{selected === item ? 'swatch-on' : ''}}"
      style="background:{{item}}"
      data-color="{{item}}" bindtap="onSelectColor"></view>
  </view>
  <view class="tip">先点下面的颜色，再点图案上的圆圈；点 ‹ › 换别的图案～</view>
</view>
