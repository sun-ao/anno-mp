.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDEEF7 0%, #F6D9EC 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #C2186B;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #C77FA6;
}

.counter {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #B03A77;
  background: #ffffff;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.pattern-nav {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  color: #C2186B;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

.nav-btn:active {
  transform: scale(0.92);
}

.pattern-name {
  min-width: 280rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #B03A77;
  background: #fff;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.canvas {
  position: relative;
  margin-top: 36rpx;
  width: 600rpx;
  height: 600rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
}

.region {
  position: absolute;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: inset 0 0 0 4rpx rgba(0, 0, 0, 0.08);
  transition: background 0.2s;
}

.done-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.done-text {
  font-size: 52rpx;
  font-weight: 800;
  color: #C2186B;
}

.again-btn {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: #EC407A;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(236, 64, 122, 0.3);
}

.palette {
  margin-top: 48rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
  width: 600rpx;
}

.swatch {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.12);
  border: 6rpx solid transparent;
  box-sizing: border-box;
}

.swatch-on {
  border-color: #333;
  transform: scale(1.08);
}

.tip {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: #C77FA6;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
