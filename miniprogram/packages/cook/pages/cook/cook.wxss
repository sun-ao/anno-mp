.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF3E0 0%, #FFE0B2 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #BF5B2A;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #D98A5A;
}

.count-panel {
  margin: 40rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 72rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.count-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #BF5B2A;
}

.count-label {
  font-size: 24rpx;
  color: #D99A6A;
}

.recipe-box {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.recipe-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #D98A5A;
  letter-spacing: 4rpx;
}

.recipe {
  margin-top: 16rpx;
  display: flex;
  gap: 20rpx;
}

.recipe-card {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 6rpx solid #F0D9B8;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.recipe-emoji {
  font-size: 76rpx;
  line-height: 1;
}

.card-done {
  opacity: 0.35;
}

.card-check {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #43A047;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(67, 160, 71, 0.4);
}

.card-current {
  border-color: #BF5B2A;
  transform: scale(1.12);
  animation: cardPulse 1s ease-in-out infinite;
  box-shadow: 0 10rpx 28rpx rgba(191, 91, 42, 0.25);
}

@keyframes cardPulse {
  0%, 100% { transform: scale(1.12); }
  50% { transform: scale(1.18); }
}

.burger-box {
  margin-top: 32rpx;
  position: relative;
  min-height: 440rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.burger {
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
}

/* 底部面包：扁圆饼 */
.bun-bottom {
  width: 340rpx;
  height: 78rpx;
  background: linear-gradient(180deg, #F2C884 0%, #D99A4E 100%);
  border-radius: 16rpx 16rpx 48rpx 48rpx;
  box-shadow: inset 0 -10rpx 0 rgba(160, 100, 30, 0.25), 0 6rpx 14rpx rgba(0, 0, 0, 0.12);
}

/* 顶部面包：圆鼓鼓 + 芝麻点 */
.bun-top {
  position: relative;
  width: 360rpx;
  height: 96rpx;
  background: linear-gradient(180deg, #F8CE82 0%, #E2A54F 100%);
  border-radius: 60% 60% 24rpx 24rpx;
  box-shadow: inset 0 -14rpx 0 rgba(160, 100, 30, 0.2), 0 6rpx 14rpx rgba(0, 0, 0, 0.1);
  animation: layerDrop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.bun-top::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 70rpx;
  width: 10rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFF3D6;
  box-shadow:
    56rpx 8rpx 0 #FFF3D6,
    120rpx -8rpx 0 #FFF3D6,
    188rpx 6rpx 0 #FFF3D6,
    34rpx 26rpx 0 #FFF3D6,
    110rpx 22rpx 0 #FFF3D6,
    166rpx 26rpx 0 #FFF3D6,
    220rpx 24rpx 0 #FFF3D6;
}

/* 配料层：紧贴堆叠 + 弹跳落下 */
.layer {
  margin-top: -8rpx;
  position: relative;
  animation: layerDrop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes layerDrop {
  from { transform: translateY(-28rpx) scale(0.95); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

/* 生菜：宽出面包一圈，两端叶片耷拉 */
.layer-leaf {
  width: 380rpx;
  height: 46rpx;
  background: linear-gradient(180deg, #7CCB5A 0%, #57A93D 100%);
  border-radius: 12rpx;
  box-shadow: inset 0 -8rpx 0 rgba(0, 0, 0, 0.12);
}

.layer-leaf::before,
.layer-leaf::after {
  content: '';
  position: absolute;
  top: 6rpx;
  width: 30rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #7CCB5A 0%, #57A93D 100%);
  border-radius: 50% 50% 10rpx 10rpx;
}

.layer-leaf::before {
  left: -20rpx;
  transform: rotate(20deg);
}

.layer-leaf::after {
  right: -20rpx;
  transform: rotate(-20deg);
}

/* 番茄：圆润切片 + 顶部高光 */
.layer-tomato {
  width: 300rpx;
  height: 52rpx;
  background: linear-gradient(180deg, #F0625A 0%, #D93B33 100%);
  border-radius: 26rpx;
  box-shadow: inset 0 8rpx 0 rgba(255, 255, 255, 0.22);
}

/* 肉饼：厚实深棕 + 油光 */
.layer-meat {
  width: 310rpx;
  height: 48rpx;
  background: linear-gradient(180deg, #8A5A34 0%, #6E4425 100%);
  border-radius: 30rpx;
  box-shadow: inset 0 -8rpx 0 rgba(0, 0, 0, 0.22), inset 0 6rpx 0 rgba(255, 200, 150, 0.12);
}

/* 奶酪：薄片 + 一角融化滴落 */
.layer-cheese {
  width: 280rpx;
  height: 34rpx;
  background: linear-gradient(180deg, #FFD54F 0%, #F5B93C 100%);
  border-radius: 10rpx;
  box-shadow: inset 0 -6rpx 0 rgba(200, 140, 20, 0.25);
}

.layer-cheese::after {
  content: '';
  position: absolute;
  right: 46rpx;
  top: 20rpx;
  width: 20rpx;
  height: 28rpx;
  background: #F5B93C;
  border-radius: 0 0 50% 50%;
}

/* 盘子 */
.plate {
  margin-top: 14rpx;
  width: 460rpx;
  height: 42rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #E6E3DF 100%);
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.14);
}

.win-cover {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.win-emoji {
  font-size: 160rpx;
}

.tray {
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.layer-btn {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.shake {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-14rpx); }
  75% { transform: translateX(14rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
