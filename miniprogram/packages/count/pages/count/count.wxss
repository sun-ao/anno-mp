.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EEF3FE 0%, #DCE6FB 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #2B4A8A;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #7A8FC0;
}

.num-display {
  margin-top: 48rpx;
  font-size: 140rpx;
  font-weight: 800;
  color: #3B6BE0;
  line-height: 1;
  height: 150rpx;
}

.obj-area {
  margin-top: 40rpx;
  width: 400rpx;
  height: 400rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.obj {
  font-size: 240rpx;
  line-height: 1;
}

.obj:active {
  transform: scale(0.95);
}

.obj-jump {
  animation: objJump 0.35s ease;
}

@keyframes objJump {
  0% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-40rpx) scale(1.08); }
  100% { transform: translateY(0) scale(1); }
}

.confetti {
  position: absolute;
  top: -20rpx;
  font-size: 120rpx;
  animation: confettiPop 1.5s ease forwards;
}

@keyframes confettiPop {
  0% { transform: scale(0); opacity: 0; }
  30% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(1); opacity: 0; }
}

.tip {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #8A9CC8;
}

.actions {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.btn {
  padding: 20rpx 56rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #3B6BE0;
  box-shadow: 0 8rpx 22rpx rgba(59, 107, 224, 0.16);
}

.btn:active {
  transform: scale(0.95);
}
