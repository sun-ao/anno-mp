.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 48rpx;
}

/* ==================== 顶部提示 ==================== */

.tip-bar {
  padding: 20rpx 32rpx 0;
}

.tip-text {
  font-size: 24rpx;
  color: #888780;
}

/* ==================== 事件列表 ==================== */

.event-list {
  padding: 16rpx 24rpx;
}

.event-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
}

.event-item:active {
  background: #f1efe8;
}

.event-item.expired {
  opacity: 0.6;
}

.event-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.event-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-target {
  font-size: 22rpx;
  color: #b4b2a9;
  margin-top: 6rpx;
}

.event-remaining {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.event-remaining-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #0F6E56;
  font-family: monospace;
}

.event-remaining-text.expired-text {
  color: #C41E3A;
}

.event-expired-hint {
  font-size: 20rpx;
  color: #C41E3A;
  margin-top: 4rpx;
}

/* ==================== 空状态 ==================== */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #888780;
}

/* ==================== 添加按钮 ==================== */

.add-btn {
  margin: 32rpx 24rpx 0;
  background: #0F6E56;
  color: #ffffff;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.add-btn:active {
  opacity: 0.8;
}

.add-btn-text {
  color: #ffffff;
}
