.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f6f7f9;
}

/* ==================== 进度条 ==================== */

.progress {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-bottom: 40rpx;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
  opacity: 0.4;
}

.progress-done,
.progress-current {
  opacity: 1;
}

.progress-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.progress-current .progress-dot {
  box-shadow: 0 0 0 6rpx rgba(24, 95, 165, 0.2);
}

.progress-check {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.progress-label {
  font-size: 22rpx;
  color: #888780;
}

.progress-done .progress-label,
.progress-current .progress-label {
  color: #1f2329;
  font-weight: 500;
}

/* ==================== 面标题 ==================== */

.face-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.face-letter {
  font-size: 36rpx;
  font-weight: 700;
  color: #185fa5;
  margin-right: 12rpx;
}

.face-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.face-count {
  font-size: 24rpx;
  color: #888780;
  margin-left: 16rpx;
}

/* ==================== 拍照阶段 ==================== */

.capture-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.camera-area {
  width: 400rpx;
  height: 400rpx;
  background: #ffffff;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.camera-icon-wrap {
  margin-bottom: 20rpx;
}

.camera-icon {
  position: relative;
  width: 100rpx;
  height: 80rpx;
}

.camera-body {
  position: absolute;
  bottom: 0;
  width: 100rpx;
  height: 64rpx;
  background: #d3d1c7;
  border-radius: 12rpx;
}

.camera-lens {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 28rpx;
  background: #b4b2a9;
  border-radius: 8rpx 8rpx 0 0;
}

.camera-body::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #888780;
  background: #f6f7f9;
}

.camera-text {
  font-size: 28rpx;
  color: #888780;
}

.album-btn {
  padding: 16rpx 40rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid #d3d1c7;
  margin-bottom: 32rpx;
}

.album-btn text {
  font-size: 26rpx;
  color: #666;
}

/* ==================== 方位提示 & 十字图 ==================== */

.tip-section {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-text {
  font-size: 26rpx;
  color: #888780;
  line-height: 1.6;
  text-align: center;
}

.orient-hint {
  font-size: 24rpx;
  color: #185fa5;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.6;
}

.cross {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cross-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.cross-cell {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 4rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.cross-spacer {
  width: 96rpx;
  height: 96rpx;
  margin: 4rpx;
}

.cross-center {
  border: 4rpx solid rgba(0, 0, 0, 0.25) !important;
  box-shadow: 0 0 0 4rpx rgba(24, 95, 165, 0.25);
}

.cross-name {
  font-size: 24rpx;
  font-weight: 600;
}

.cross-dir {
  font-size: 20rpx;
  opacity: 0.7;
  margin-top: 2rpx;
}

/* ==================== 识别结果阶段 ==================== */

.review-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  width: 264rpx;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.color-cell {
  width: 80rpx;
  height: 80rpx;
  margin: 4rpx;
  border-radius: 12rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
}

.color-cell-center {
  border: 3rpx solid rgba(0, 0, 0, 0.35) !important;
}

.color-cell-empty {
  background: #e8e6e0 !important;
  border-color: #d3d1c7 !important;
}

.cell-letter {
  font-size: 28rpx;
  font-weight: 600;
}

.review-hint {
  font-size: 24rpx;
  color: #888780;
  margin-bottom: 40rpx;
}

.review-actions {
  display: flex;
  justify-content: center;
}

/* ==================== 完成阶段 ==================== */

.done-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.done-title {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.done-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #185fa5;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  text-align: center;
  line-height: 48rpx;
}

.done-title text:last-child {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.done-preview {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 32rpx;
}

.done-actions {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

/* ==================== 通用按钮 ==================== */

.btn {
  margin: 0 16rpx;
  padding: 20rpx 52rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn-plain {
  background: #ffffff;
  color: #1f2329;
  border: 1rpx solid #d3d1c7;
}

.btn-primary {
  background: #185fa5;
  color: #ffffff;
}

.btn-disabled {
  background: #b4b2a9 !important;
}

/* ==================== 错误提示 ==================== */

.error {
  padding: 16rpx 32rpx;
  background: #fcebeb;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.error-text {
  color: #a32d2d;
  font-size: 24rpx;
}

/* ==================== 加载遮罩 ==================== */

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
}
