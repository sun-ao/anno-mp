.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

.hint {
  margin-top: 8rpx;
  padding: 10rpx 32rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #BA7517;
}

/* 当前阶段要点卡 */
.phase-card {
  width: 686rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border-left: 8rpx solid #BA7517;
}

.phase-progress-text {
  font-size: 22rpx;
  color: #BA7517;
  font-weight: 600;
}

.phase-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.phase-goal {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #555555;
  line-height: 1.6;
}

.phase-tip {
  margin-top: 16rpx;
  background: #fbf1de;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  display: flex;
  flex-direction: column;
}

.phase-tip-label {
  font-size: 22rpx;
  color: #BA7517;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.phase-tip-text {
  font-size: 24rpx;
  color: #7a5a23;
  line-height: 1.6;
}

/* 七阶段进度条 */
.phase-strip {
  margin-top: 24rpx;
  width: 686rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.phase-dot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.phase-dot::before {
  content: '';
  position: absolute;
  top: 22rpx;
  left: -50%;
  width: 100%;
  height: 4rpx;
  background: #e6e3da;
  z-index: 0;
}

.phase-dot:first-child::before {
  display: none;
}

.phase-dot-done::before,
.phase-dot-active::before {
  background: #BA7517;
}

.phase-dot-num {
  position: relative;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  background: #ffffff;
  border: 2rpx solid #d3d1c7;
  color: #b4b2a9;
}

.phase-dot-done .phase-dot-num {
  background: #BA7517;
  border-color: #BA7517;
  color: #ffffff;
}

.phase-dot-active .phase-dot-num {
  background: #ffffff;
  border-color: #BA7517;
  color: #BA7517;
  box-shadow: 0 0 0 6rpx rgba(186, 117, 23, 0.15);
}

.phase-dot-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b4b2a9;
  text-align: center;
  line-height: 1.3;
}

.phase-dot-active .phase-dot-label {
  color: #BA7517;
  font-weight: 600;
}

.phase-dot-done .phase-dot-label {
  color: #8a6a30;
}

/* 控制条 */
.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.ctrl {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #d3d1c7;
  font-size: 28rpx;
  margin: 0 16rpx;
}

.ctrl-primary {
  background: #BA7517;
  border-color: #BA7517;
  color: #ffffff;
}

.ctrl-disabled {
  opacity: 0.35;
}

.progress {
  font-size: 26rpx;
  color: #888780;
  min-width: 120rpx;
  text-align: center;
}

/* 本阶段公式 */
.formula {
  margin-top: 24rpx;
  padding: 20rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  width: 686rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.formula-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.formula-label {
  font-size: 22rpx;
  color: #888780;
}

.auto-area {
  display: flex;
  align-items: center;
}

.auto-link {
  font-size: 24rpx;
  color: #BA7517;
  padding: 8rpx 12rpx;
  margin-right: 8rpx;
  border-radius: 8rpx;
}

.auto-link-active {
  color: #C41E3A;
  background: #fcebeb;
}

.interval-link {
  font-size: 24rpx;
  color: #888780;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.formula-empty {
  font-size: 26rpx;
  color: #6bbf59;
  padding: 8rpx 0;
}

.formula-text {
  font-size: 30rpx;
  letter-spacing: 2rpx;
  word-break: break-all;
  line-height: 1.8;
}

.formula-move {
  font-size: 30rpx;
}

.formula-move-active {
  color: #C41E3A;
  font-weight: 600;
  font-size: 36rpx;
}

.formula-move-done {
  color: #b4b2a9;
}

/* 全部分步 */
.steps {
  margin-top: 20rpx;
  width: 686rpx;
  max-height: 320rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.step-divider {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx 10rpx;
}

.step-divider-bar {
  flex: 1;
  height: 2rpx;
  background: #ece9e0;
}

.step-divider-title {
  margin: 0 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #BA7517;
  white-space: nowrap;
}

.step {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-left: 6rpx solid transparent;
  transition: background 0.2s;
}

.step-no {
  width: 56rpx;
  font-size: 24rpx;
  color: #b4b2a9;
}

.step-move {
  width: 90rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  color: #555555;
}

.step-done {
  opacity: 0.4;
}

.step-next {
  background: #fbf1de;
  border-left-color: #BA7517;
  border-radius: 0 12rpx 12rpx 0;
}

.step-next .step-no {
  color: #BA7517;
  font-weight: 500;
}

.step-next .step-move {
  color: #BA7517;
  font-size: 32rpx;
}

.step-flag {
  font-size: 20rpx;
  color: #ffffff;
  background: #BA7517;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.back-link {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #888780;
  padding: 8rpx 24rpx;
}

.back-link:active {
  color: #BA7517;
}
