<view class="page">
  <view class="hero">
    <view class="hero-icon">🧩</view>
    <view class="hero-title">魔方已识别，选择还原方式</view>
    <view class="hero-sub" wx:if="{{totalMoves > 0}}">后端已算出解法，共 {{totalMoves}} 步可选最短求解，或按课堂七步慢慢学</view>
    <view class="hero-sub" wx:else>后端已算出解法，挑一种方式开始还原</view>
  </view>

  <!-- 卡片一：智能求解 -->
  <view class="card card-smart" bindtap="onChooseSmart">
    <view class="card-left">
      <view class="card-icon">⚡</view>
      <view class="card-main">
        <view class="card-title">智能求解</view>
        <view class="card-desc">最短解法，一步到位还原魔方</view>
        <view class="card-tags">
          <text class="tag tag-smart">最短步数</text>
          <text class="tag tag-smart">适合直接还原</text>
        </view>
      </view>
    </view>
    <view class="card-go">开始 ›</view>
  </view>

  <!-- 卡片二：课堂还原 -->
  <view class="card card-class" bindtap="onChooseClassroom">
    <view class="card-left">
      <view class="card-icon">📚</view>
      <view class="card-main">
        <view class="card-title">课堂还原</view>
        <view class="card-desc">按魔方课堂七步法，边看要点边还原</view>
        <view class="card-tags">
          <text class="tag tag-class">7 个阶段</text>
          <text class="tag tag-class">边学边练</text>
        </view>
      </view>
    </view>
    <view class="card-go">开始 ›</view>
  </view>

  <view class="back-link" bindtap="onBack">返回修改配色</view>
</view>
