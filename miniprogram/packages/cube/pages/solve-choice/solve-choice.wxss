.page {
  min-height: 100vh;
  background: #f6f7f9;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部说明 */
.hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.hero-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #888780;
  text-align: center;
  line-height: 1.5;
  padding: 0 20rpx;
}

/* 卡片 */
.card {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
}

.card-smart::before { background: #185fa5; }
.card-class::before { background: #BA7517; }

.card:active {
  transform: scale(0.985);
  transition: transform 0.12s;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.card-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-smart .card-icon { background: #e6f1fb; }
.card-class .card-icon { background: #fbf1de; }

.card-main {
  min-width: 0;
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b6f76;
  line-height: 1.4;
}

.card-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  line-height: 1.4;
}

.tag-smart { color: #185fa5; background: #e6f1fb; }
.tag-class { color: #BA7517; background: #fbf1de; }

.card-go {
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.card-smart .card-go { color: #185fa5; }
.card-class .card-go { color: #BA7517; }

.back-link {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888780;
  padding: 8rpx 24rpx;
}

.back-link:active {
  color: #185fa5;
}
