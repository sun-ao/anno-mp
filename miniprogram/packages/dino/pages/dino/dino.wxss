.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #EAF7EC 0%, #D8F0DC 100%);
  padding: 48rpx 32rpx 0;
  box-sizing: border-box;
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 0;
}

.shake-on {
  animation: screenShake 0.5s ease;
}

@keyframes screenShake {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(-8rpx, 4rpx); }
  40% { transform: translate(8rpx, -4rpx); }
  60% { transform: translate(-6rpx, -4rpx); }
  80% { transform: translate(6rpx, 4rpx); }
}

.count-panel {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 72rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.count-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #2E7D32;
}

.count-label {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #9CB89E;
}

.dino-scroll {
  flex: 1;
  width: 100%;
  margin-top: 64rpx;
  overflow: hidden;
  -webkit-overflow-scrolling: touch;
  min-height: 0;
}

.dino-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
  padding-bottom: 60rpx;
}

.dino {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 32rpx;
  padding: 36rpx 0 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.dino-emoji {
  font-size: 120rpx;
  line-height: 1.1;
}

.dino-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #4C7A50;
}

.dino:active {
  transform: scale(0.96);
}

.dino-roar {
  animation: dinoRoar 0.5s ease;
}

@keyframes dinoRoar {
  0% { transform: scale(1); }
  35% { transform: scale(1.25) rotate(-6deg); }
  65% { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1); }
}

.burst {
  flex-shrink: 0;
  margin-top: 40rpx;
  font-size: 88rpx;
  font-weight: 800;
  color: #2E7D32;
  opacity: 0;
  transform: scale(0.4);
}

.burst-on {
  animation: burstIn 0.9s ease forwards;
}

@keyframes burstIn {
  0% { opacity: 0; transform: scale(0.4); }
  30% { opacity: 1; transform: scale(1.2); }
  60% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(1); }
}

.tip {
  flex-shrink: 0;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  color: #8AA98C;
}
