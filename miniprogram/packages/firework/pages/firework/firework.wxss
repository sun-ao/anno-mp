.page {
  min-height: 100vh;
  background: #0F1030;
}

.sky {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #0B0B2B 0%, #1A1B4B 100%);
}

.star {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
}

.star-1 { top: 12%; left: 20%; }
.star-2 { top: 22%; left: 75%; }
.star-3 { top: 40%; left: 48%; }

.launched-panel {
  position: absolute;
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  padding: 20rpx 60rpx;
  z-index: 20;
}

.launched-num {
  font-size: 60rpx;
  font-weight: 800;
  color: #FFD166;
}

.launched-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.launched-clear {
  margin-top: 16rpx;
  padding: 10rpx 32rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFD166;
  background: rgba(255, 209, 102, 0.14);
  border: 2rpx solid rgba(255, 209, 102, 0.5);
  border-radius: 999rpx;
}

.launched-clear:active {
  background: rgba(255, 209, 102, 0.28);
}

.hint {
  position: absolute;
  bottom: 48rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  z-index: 20;
}

/* 上升的烟花弹 */
.rocket {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  margin-top: -8rpx;
  border-radius: 50%;
  z-index: 5;
  animation: rocketRise 0.43s ease-out forwards;
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.8);
}

@keyframes rocketRise {
  from { transform: translateY(45vh); opacity: 0.9; }
  to { transform: translateY(0); opacity: 1; }
}

/* 炸开效果 */
.burst {
  position: absolute;
  width: 0;
  height: 0;
  z-index: 6;
}

.burst-ring {
  position: absolute;
  left: -50rpx;
  top: -50rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 6rpx solid;
  animation: ringOut 0.8s ease-out forwards;
}

@keyframes ringOut {
  from { transform: scale(0.2); opacity: 1; }
  to { transform: scale(1.8); opacity: 0; }
}

.spark-arm {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
}

.spark {
  position: absolute;
  left: 0;
  top: -6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  animation: sparkFly 0.9s ease-out forwards;
}

@keyframes sparkFly {
  from { transform: translateX(8rpx); opacity: 1; }
  to { transform: translateX(90rpx); opacity: 0; }
}
