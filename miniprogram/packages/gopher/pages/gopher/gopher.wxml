<view class="page">
  <view class="title-area">
    <text class="title">打地鼠</text>
    <text class="subtitle">看提示，打指定的小动物</text>
  </view>

  <view class="target-tip">
    <text class="target-label">这一次要打</text>
    <view class="target-chip">{{target}}</view>
  </view>

  <view class="count-panel">
    <text class="count-num">{{whacked}}</text>
    <text class="count-label">打中的小动物</text>
    <view class="score-clear" bindtap="onClear">清空</view>
  </view>

  <view class="hole-grid">
    <view
      wx:for="{{holes}}"
      wx:key="id"
      class="hole {{wrongId === item.id ? 'hole-wrong' : ''}}"
      data-id="{{item.id}}"
      bindtap="onWhack"
    >
      <view class="animal {{item.up ? 'animal-up' : ''}}">{{item.animal}}</view>
      <view class="mound"></view>
    </view>
  </view>
</view>
