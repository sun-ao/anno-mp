.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5F0E6 0%, #EAE2D0 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #7A5A2B;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #B08A4A;
}

.target-tip {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(122, 90, 43, 0.12);
}

.target-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #7A5A2B;
  margin-right: 18rpx;
}

.target-chip {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  line-height: 1;
  background: #FFF3D6;
  border: 4rpx solid #F0B429;
  border-radius: 24rpx;
}

.count-panel {
  margin: 40rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 72rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.count-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #A0672B;
}

.count-label {
  font-size: 24rpx;
  color: #B99A6A;
}

.hole-grid {
  margin-top: 48rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32rpx;
}

.hole {
  height: 190rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.hole-wrong {
  animation: holeShake 0.45s ease;
}

@keyframes holeShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

.mound {
  width: 150rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #8A6A3B;
  box-shadow: inset 0 8rpx 16rpx rgba(0, 0, 0, 0.25);
}

.animal {
  position: absolute;
  bottom: 40rpx;
  font-size: 100rpx;
  line-height: 1;
  transform: translateY(70rpx);
  opacity: 0;
}

.animal-up {
  animation: animalPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes animalPop {
  from { transform: translateY(70rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
