<view class="page">
  <view class="title-area">
    <view class="title">投篮</view>
    <view class="subtitle">看准时机，把球投进筐里 🏀</view>
  </view>
  <view class="counter">投进 {{score}} 个</view>
  <view class="score-clear" bindtap="onClear">清空</view>
  <view class="court">
    <view class="hoop" style="left:{{hoopX}}%">
      <view class="hoop-board"></view>
      <view class="hoop-ring"></view>
    </view>
    <view class="ball {{phase === 'fly' ? 'ball-fly' : ''}} {{phase === 'score' ? 'ball-score' : ''}} {{phase === 'miss' ? 'ball-miss' : ''}}" style="left:{{ballX}}%" bindtap="onShoot">
      <text class="ball-emoji">🏀</text>
    </view>
    <view wx:if="{{phase === 'miss'}}" class="miss-text">差一点！</view>
  </view>
  <view class="tip">筐左右移动，等球正好落进圈圈里再点～越投越快，挑战一下！</view>
</view>
