.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF1E8 0%, #FFD9C2 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #D2542A;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #D08C6A;
}

.counter {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #C0492A;
  background: #ffffff;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.court {
  position: relative;
  margin-top: 48rpx;
  width: 100%;
  height: 720rpx;
  background: linear-gradient(180deg, #FFE3C9 0%, #F6B98C 100%);
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: inset 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.hoop {
  position: absolute;
  top: 70rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hoop-board {
  width: 210rpx;
  height: 32rpx;
  background: #E53935;
  border-radius: 8rpx;
}

.hoop-ring {
  margin-top: 8rpx;
  width: 150rpx;
  height: 150rpx;
  border: 16rpx solid #FF7043;
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.15);
}

.ball {
  position: absolute;
  bottom: 80rpx;
  transform: translateX(-50%);
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ball-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.ball-fly {
  animation: ball-fly 0.5s ease-out forwards;
}

@keyframes ball-fly {
  0%   { transform: translateX(-50%) translateY(0); }
  100% { transform: translateX(-50%) translateY(-405rpx); }
}

/* 进球：从筐口继续下落缩小，像穿过筐 */
.ball-score {
  animation: ball-score 0.38s ease-in forwards;
}

@keyframes ball-score {
  0%   { transform: translateX(-50%) translateY(-405rpx) scale(1); opacity: 1; }
  100% { transform: translateX(-50%) translateY(-185rpx) scale(0.2); opacity: 0; }
}

/* 没进：在筐口擦边弹开、落回 */
.ball-miss {
  animation: ball-miss 0.5s ease-out forwards;
}

@keyframes ball-miss {
  0%   { transform: translateX(-50%) translateY(-405rpx); }
  30%  { transform: translateX(-50%) translateY(-355rpx); }
  100% { transform: translateX(-50%) translateY(160rpx) scale(0.5); opacity: 0.25; }
}

.miss-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 200rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #D2542A;
}

.tip {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #D08C6A;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
