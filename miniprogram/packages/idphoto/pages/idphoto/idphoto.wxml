<view class="page">
  <!-- 未选图 -->
  <view wx:if="{{!imageReady}}" class="upload-area" bindtap="onChooseImage">
    <view class="upload-icon">+</view>
    <text class="upload-title">选择照片</text>
    <text class="upload-hint">从相册选择或拍摄，建议纯色背景</text>
  </view>

  <!-- 已选图 -->
  <block wx:else>
    <view class="canvas-wrap">
      <canvas
        type="2d"
        id="idCanvas"
        class="id-canvas"
        hidden="{{!canvasVisible}}"
        disable-scroll="true"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
      ></canvas>
      <text class="canvas-tip">单指移动 · 双指缩放 · 参考线对齐头部</text>
    </view>

    <!-- 规格选择 -->
    <view class="section-label">尺寸规格</view>
    <view class="chip-row">
      <view
        wx:for="{{specs}}"
        wx:key="key"
        class="chip {{selectedSpec === item.key ? 'active' : ''}}"
        bindtap="onSelectSpec"
        data-key="{{item.key}}"
      >
        <text class="chip-name">{{item.name}}</text>
        <text class="chip-mm">{{item.mm}}</text>
      </view>
    </view>

    <!-- 底色选择 -->
    <view class="section-label">背景色</view>
    <view class="chip-row">
      <view
        wx:for="{{bgColors}}"
        wx:key="key"
        class="chip bg-chip {{selectedBg === item.key ? 'active' : ''}}"
        bindtap="onSelectBg"
        data-key="{{item.key}}"
      >
        <view class="bg-dot" style="background: {{item.hex || '#f1efe8'}};"></view>
        <text class="chip-name">{{item.name}}</text>
      </view>
    </view>
    <view wx:if="{{selectedBg !== 'origin'}}" class="bg-hint">
      <text class="bg-hint-text">换底色仅对纯色背景照片有效，效果不佳请选「原图」</text>
    </view>

    <!-- 操作按钮 -->
    <view class="actions">
      <view class="btn btn-primary {{generating ? 'btn-disabled' : ''}}" bindtap="onGenerate">生成证件照</view>
      <view class="btn btn-secondary {{generating ? 'btn-disabled' : ''}}" bindtap="onPrintLayout">排版打印</view>
    </view>
    <view class="actions">
      <view class="btn btn-ghost" bindtap="onChangeImage">重新选图</view>
    </view>
  </block>

  <!-- 预览弹窗 -->
  <view wx:if="{{showPreview}}" class="mask" bindtap="onClosePreview">
    <view class="preview-dialog" catchtap="noop">
      <image src="{{previewSrc}}" class="preview-image" mode="widthFix"></image>
      <view class="preview-actions">
        <view class="preview-btn" bindtap="onSavePreview">保存到相册</view>
        <view class="preview-btn ghost" bindtap="onClosePreview">关闭</view>
      </view>
    </view>
  </view>
</view>
