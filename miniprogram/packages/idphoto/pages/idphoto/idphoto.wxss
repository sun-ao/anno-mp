.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 0 0 120rpx;
}

/* ==================== 未选图 ==================== */

.upload-area {
  margin: 24rpx;
  padding: 120rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 2rpx dashed #d3d1c7;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-area:active {
  background: #f1efe8;
}

.upload-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E24B4A;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.upload-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2329;
}

.upload-hint {
  font-size: 24rpx;
  color: #b4b2a9;
  margin-top: 12rpx;
}

/* ==================== 画布 ==================== */

.canvas-wrap {
  margin: 24rpx 24rpx 0;
  position: relative;
}

.id-canvas {
  width: 100%;
  height: 520rpx;
  background: #1f2329;
  border-radius: 20rpx;
}

.canvas-tip {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ==================== 选择行 ==================== */

.section-label {
  padding: 24rpx 36rpx 12rpx;
  font-size: 26rpx;
  color: #888780;
}

.chip-row {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.chip {
  flex: 1;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}

.chip.active {
  border-color: #E24B4A;
  background: #fdf3f3;
}

.chip-name {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}

.chip.active .chip-name {
  color: #E24B4A;
}

.chip-mm {
  font-size: 20rpx;
  color: #b4b2a9;
  margin-top: 4rpx;
}

.bg-chip {
  flex-direction: row;
  gap: 8rpx;
}

.bg-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #e5e3db;
}

.bg-hint {
  padding: 12rpx 36rpx 0;
}

.bg-hint-text {
  font-size: 22rpx;
  color: #b4b2a9;
}

/* ==================== 操作按钮 ==================== */

.actions {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: #E24B4A;
  color: #ffffff;
}

.btn-secondary {
  background: #ffffff;
  color: #1f2329;
  border: 1rpx solid #e5e3db;
}

.btn-ghost {
  background: transparent;
  color: #888780;
  border: 1rpx solid #d3d1c7;
}

.btn-disabled {
  opacity: 0.6;
}

.btn:active {
  opacity: 0.85;
}

/* ==================== 预览弹窗 ==================== */

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-dialog {
  width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-image {
  width: 320rpx;
  border-radius: 8rpx;
  margin-bottom: 32rpx;
}

.preview-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.preview-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #E24B4A;
  color: #ffffff;
  font-weight: 500;
}

.preview-btn.ghost {
  background: #f1efe8;
  color: #888780;
  font-weight: 400;
}

.preview-btn:active {
  opacity: 0.85;
}
