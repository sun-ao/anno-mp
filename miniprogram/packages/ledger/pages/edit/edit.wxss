.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 0 0 120rpx;
}

.type-toggle {
  display: flex;
  background: #ffffff;
  padding: 20rpx 32rpx;
  gap: 16rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #888780;
  background: #f1efe8;
}

.type-btn.active {
  background: #BA7517;
  color: #ffffff;
  font-weight: 500;
}

.amount-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 16rpx;
  padding: 32rpx;
  border-radius: 20rpx;
}

.amount-symbol {
  font-size: 48rpx;
  color: #1f2329;
  font-weight: 500;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: 500;
  color: #1f2329;
}

.amount-placeholder {
  color: #d3d1c7;
  font-weight: 400;
}

.section-label {
  padding: 24rpx 32rpx 12rpx;
  font-size: 26rpx;
  color: #888780;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  background: #ffffff;
  margin: 0 16rpx;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  border: 4rpx solid transparent;
}

.category-item.selected .category-icon {
  border-color: #BA7517;
}

.category-icon-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
}

.category-name {
  font-size: 22rpx;
  color: #555555;
}

.category-item.selected .category-name {
  color: #BA7517;
  font-weight: 500;
}

/* 添加分类按钮 */
.category-add-icon {
  background: #f1efe8 !important;
  border: 2rpx dashed #c5c3ba;
}

.category-add-text {
  color: #b4b2a9;
  font-size: 40rpx;
  font-weight: 300;
}

/* ==================== 自定义分类弹窗 ==================== */

.cat-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-dialog {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-dialog-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  margin-bottom: 32rpx;
}

.cat-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.cat-preview-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.cat-preview-text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 500;
}

.cat-preview-name {
  font-size: 26rpx;
  color: #888780;
}

.cat-input {
  width: 100%;
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  margin-bottom: 24rpx;
}

.cat-color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.cat-color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
}

.cat-color-dot.selected {
  border-color: #1f2329;
}

.cat-color-check {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.cat-custom-color {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 32rpx;
}

.cat-custom-color-label {
  font-size: 26rpx;
  color: #888780;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.cat-custom-color-input {
  flex: 1;
  background: #f6f7f9;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #1f2329;
  font-family: monospace;
}

.cat-custom-color-preview {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  border: 1rpx solid #f0efe8;
}

.cat-dialog-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.cat-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.cat-btn-cancel {
  background: #f1efe8;
  color: #888780;
}

.cat-btn-confirm {
  background: #BA7517;
  color: #ffffff;
  font-weight: 500;
}

.cat-btn:active {
  opacity: 0.85;
}

.form-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 16rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #888780;
  width: 100rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
}

.form-placeholder {
  color: #c5c3ba;
}

.form-value {
  font-size: 28rpx;
  color: #1f2329;
}

.form-value.placeholder {
  color: #c5c3ba;
}

.form-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid #b4b2a9;
  border-right: 3rpx solid #b4b2a9;
  transform: rotate(45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ==================== 日期 + 钱包 一行 ==================== */

.double-row {
  display: flex;
  padding: 0;
  overflow: hidden;
}

.double-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  min-width: 0;
}

.double-item + .double-item {
  border-left: 1rpx solid #f0efe8;
}

.double-item .form-label {
  width: 68rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.wallet-name-inline {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== 账户选择行 ==================== */

.wallet-select {
  display: flex;
  align-items: center;
  flex: 1;
}

.wallet-select-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.wallet-select-icon-text {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
}

/* ==================== 钱包选择弹窗 ==================== */

.wallet-picker {
  width: 600rpx;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 0 16rpx;
  display: flex;
  flex-direction: column;
}

.wallet-picker-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  padding: 0 32rpx 24rpx;
}

.wallet-picker-list {
  overflow-y: auto;
  padding: 0 32rpx 16rpx;
}

.wallet-picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.wallet-picker-item.active {
  background: #fdf6ec;
}

.wallet-picker-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.wallet-picker-icon-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.wallet-picker-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.wallet-picker-name {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}

.wallet-picker-balance {
  font-size: 22rpx;
  color: #888780;
  margin-top: 4rpx;
}

.wallet-picker-check {
  font-size: 32rpx;
  color: #BA7517;
  margin-left: 12rpx;
}

/* ==================== 日历弹窗 ==================== */

.calendar-dialog {
  width: 620rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx 24rpx;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 24rpx;
}

.calendar-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.calendar-arrow {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.calendar-arrow::after {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #1f2329;
  border-right: 4rpx solid #1f2329;
  transform: rotate(45deg);
  margin-left: -8rpx;
}

.calendar-arrow.prev::after {
  transform: rotate(-135deg);
  margin-left: 8rpx;
}

.calendar-arrow.disabled::after {
  border-top-color: #d3d1c7;
  border-right-color: #d3d1c7;
}

.calendar-weekdays {
  display: flex;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0efe8;
  margin-bottom: 8rpx;
}

.calendar-weekday {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: #888780;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: 14.28%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-day-text {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: #1f2329;
}

.calendar-day.selected .calendar-day-text {
  background: #BA7517;
  color: #ffffff;
  font-weight: 500;
}

.calendar-day.disabled .calendar-day-text {
  color: #d3d1c7;
}

.calendar-day.today .calendar-day-text {
  border: 2rpx solid #BA7517;
  color: #BA7517;
}

.actions {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0 32rpx;
  gap: 24rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-save {
  background: #BA7517;
  color: #ffffff;
}

.btn-delete {
  background: #ffffff;
  color: #C41E3A;
  border: 1rpx solid #f0c1c1;
}

.btn:active {
  opacity: 0.85;
}
