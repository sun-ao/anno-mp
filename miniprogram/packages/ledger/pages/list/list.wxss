.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7f9;
}

.header {
  background: #ffffff;
  padding: 24rpx 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.left-entries {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wallet-entry {
  padding: 8rpx 20rpx;
  background: #f1efe8;
  border-radius: 24rpx;
}

.wallet-entry-text {
  font-size: 24rpx;
  color: #BA7517;
  font-weight: 500;
}

.month-nav {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: center;
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-text {
  font-size: 40rpx;
  color: #888780;
}

.month-text {
  font-size: 32rpx;
  font-weight: 500;
  margin: 0 24rpx;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-label {
  font-size: 22rpx;
  color: #888780;
  margin-bottom: 8rpx;
}

.summary-amount {
  font-size: 30rpx;
  font-weight: 500;
}

.summary-amount.income {
  color: #0F6E56;
}

.summary-amount.expense {
  color: #C41E3A;
}

.summary-divider {
  width: 1rpx;
  height: 48rpx;
  background: #e8e6e0;
}

.bill-list {
  flex: 1;
  padding: 0 24rpx 140rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 12rpx 12rpx;
}

.date-text {
  font-size: 24rpx;
  color: #888780;
}

.date-total {
  font-size: 22rpx;
  color: #b4b2a9;
}

.bill-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.bill-item:active {
  background: #f1efe8;
}

.bill-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bill-icon-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.bill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bill-category {
  font-size: 28rpx;
  font-weight: 500;
}

.bill-note {
  font-size: 22rpx;
  color: #888780;
  margin-top: 4rpx;
}

.bill-meta {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  gap: 12rpx;
}

.bill-wallet {
  font-size: 20rpx;
  opacity: 0.7;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 500;
}

.bill-amount.expense {
  color: #C41E3A;
}

.bill-amount.income {
  color: #0F6E56;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #888780;
}

.empty-hint {
  font-size: 24rpx;
  color: #b4b2a9;
  margin-top: 12rpx;
}

.fab {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #BA7517;
  color: #ffffff;
  padding: 22rpx 64rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(186, 117, 23, 0.3);
  z-index: 10;
}

.fab:active {
  transform: translateX(-50%) scale(0.96);
}

.fab-text {
  color: #ffffff;
}
