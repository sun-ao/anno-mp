.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f7f9;
}

.header {
  background: #ffffff;
  padding: 20rpx 24rpx 8rpx;
  border-bottom: 1rpx solid #eef0f2;
}

.mode-tabs {
  display: flex;
  background: #f0f1f3;
  border-radius: 12rpx;
  padding: 6rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #6b6f76;
  border-radius: 10rpx;
}

.mode-tab.active {
  background: #ffffff;
  color: #BA7517;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.period-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 22rpx 0 10rpx;
}

.arrow {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f1f3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-text {
  font-size: 40rpx;
  color: #6b6f76;
  line-height: 1;
}

.period-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  min-width: 220rpx;
  text-align: center;
}

.custom-range {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 6rpx 0 18rpx;
}

.range-field {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx;
  background: #f6f7f9;
  border-radius: 10rpx;
}

.range-label {
  font-size: 24rpx;
  color: #9a9ea6;
}

.range-value {
  font-size: 26rpx;
  color: #333;
}

.range-sep {
  color: #9a9ea6;
  font-size: 26rpx;
}

.summary {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: 16rpx 24rpx;
  padding: 28rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #9a9ea6;
}

.summary-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.summary-amount.income { color: #0F6E56; }
.summary-amount.expense { color: #E24B4A; }

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eee;
}

.content {
  flex: 1;
  padding: 0 24rpx 40rpx;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.section-total {
  font-size: 24rpx;
  color: #9a9ea6;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 0;
}

.cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cat-icon-text {
  color: #fff;
  font-size: 28rpx;
}

.cat-main {
  flex: 1;
  min-width: 0;
}

.cat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cat-name {
  font-size: 26rpx;
  color: #333;
}

.cat-amount {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.cat-amount.income { color: #0F6E56; }

.cat-bar-bg {
  height: 14rpx;
  background: #f0f1f3;
  border-radius: 999rpx;
  overflow: hidden;
}

.cat-bar {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.cat-percent {
  width: 72rpx;
  text-align: right;
  font-size: 24rpx;
  color: #9a9ea6;
  flex-shrink: 0;
}

.trend-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.trend-month {
  width: 64rpx;
  font-size: 24rpx;
  color: #6b6f76;
  flex-shrink: 0;
}

.trend-bar-bg {
  flex: 1;
  height: 20rpx;
  background: #f0f1f3;
  border-radius: 999rpx;
  overflow: hidden;
}

.trend-bar {
  height: 100%;
  background: #BA7517;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.trend-amount {
  width: 160rpx;
  text-align: right;
  font-size: 24rpx;
  color: #333;
  flex-shrink: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #6b6f76;
}

.empty-hint {
  font-size: 24rpx;
  color: #b5b9c0;
}
