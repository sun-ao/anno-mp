.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F4ECFF 0%, #E6D6FB 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #8E24AA;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #A968C0;
}

.counter {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #8E24AA;
  background: #ffffff;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.board {
  margin-top: 56rpx;
  width: 600rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.tile {
  height: 130rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}

.tile-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.tile-sel {
  transform: scale(0.9);
  box-shadow: 0 0 0 6rpx #FFB300;
}

.tile-clear {
  background: transparent;
  box-shadow: none;
}

.tile-shake {
  animation: tile-shake 0.4s;
}

@keyframes tile-shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-12rpx); }
  75% { transform: translateX(12rpx); }
}

.tip {
  margin-top: 56rpx;
  font-size: 26rpx;
  color: #A968C0;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
