<view class="page">
  <view class="count-panel">
    <text class="count-num">{{total}}</text>
    <text class="count-label">⭐</text>
    <view class="score-clear" bindtap="onClear">清空</view>
  </view>

  <view class="target-card">
    <text class="target-label">照着找 👇</text>
    <view class="target-emoji-box">
      <text class="target-emoji">{{target}}</text>
    </view>
  </view>

  <view class="tip-row">👇 点出一样的 👇</view>

  <view class="car-row">
    <view
      wx:for="{{options}}"
      wx:key="id"
      class="car {{winIdx === index ? 'car-win' : ''}} {{shakeIdx === index ? 'car-shake' : ''}}"
      data-idx="{{index}}"
      bindtap="onTapOption"
    >
      <text class="car-emoji">{{item.emoji}}</text>
      <text wx:if="{{winIdx === index}}" class="car-mark">✅</text>
    </view>
  </view>

  <view class="new-btn" bindtap="onTapNew">🔄 换一批</view>
</view>
