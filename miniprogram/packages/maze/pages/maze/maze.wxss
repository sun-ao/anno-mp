.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF6EC 0%, #F3E7D4 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #7A5A2B;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #B08A4A;
}

.panel-row {
  margin: 40rpx auto 0;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.stat-panel {
  flex: 1;
  max-width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #7A5A2B;
  line-height: 1.2;
}

.stat-num.time {
  font-size: 40rpx;
  color: #E67E22;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B99A6A;
}

.maze-box {
  margin-top: 32rpx;
  position: relative;
  background: #FFFDF7;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.cell {
  position: relative;
  height: 152rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #E9DECA;
  box-sizing: border-box;
}

.cell-player {
  background: #FFF3D6;
}

.cell-goal {
  background: #FFF9E8;
}

.w-top { border-top-width: 10rpx; border-top-color: #8B6B3D; }
.w-right { border-right-width: 10rpx; border-right-color: #8B6B3D; }
.w-bottom { border-bottom-width: 10rpx; border-bottom-color: #8B6B3D; }
.w-left { border-left-width: 10rpx; border-left-color: #8B6B3D; }

/* 大棋盘（6×6 起）：格子小，墙线相应变细 */
.grid-sm .cell {
  border-width: 2rpx;
}

.grid-sm .w-top { border-top-width: 6rpx; }
.grid-sm .w-right { border-right-width: 6rpx; }
.grid-sm .w-bottom { border-bottom-width: 6rpx; }
.grid-sm .w-left { border-left-width: 6rpx; }

.win-cover {
  position: absolute;
  inset: 0;
  background: rgba(255, 253, 247, 0.92);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.win-emoji {
  font-size: 140rpx;
  line-height: 1;
}

.win-text {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #7A5A2B;
}

.win-sub {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #B5713F;
}

.win-sub2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B99A6A;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
