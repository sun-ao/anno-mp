.page {
  min-height: 100vh;
  background: #f6f7f9;
  display: flex;
  flex-direction: column;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

/* 进度 */
.progress-row {
  display: flex;
  align-items: center;
}

.progress-text {
  width: 100rpx;
  font-size: 26rpx;
  color: #5E5CE6;
  font-weight: 600;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #E8E7F7;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #8B86F2, #5E5CE6);
  transition: width 0.25s;
}

/* 题目 */
.q-card {
  margin-top: 48rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 56rpx 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(94, 92, 230, 0.08);
}

.q-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #2E2C4A;
  line-height: 1.6;
}

/* 选项 */
.opts {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
}

.opt {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid transparent;
  transition: border-color 0.15s, background 0.15s;
}

.opt:active {
  opacity: 0.8;
}

.opt-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EFEEFC;
  color: #5E5CE6;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.opt-text {
  margin-left: 24rpx;
  font-size: 30rpx;
  color: #3A3860;
  line-height: 1.5;
}

.opt-active {
  border-color: #5E5CE6;
  background: #F4F3FE;
}

.opt-active .opt-mark {
  background: #5E5CE6;
  color: #ffffff;
}

/* 底部导航 */
.nav-row {
  margin-top: auto;
  padding-top: 40rpx;
  display: flex;
  justify-content: center;
}

.prev-btn {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #DDDBF2;
  color: #8B86F2;
  font-size: 26rpx;
}

.prev-btn:active {
  opacity: 0.8;
}
