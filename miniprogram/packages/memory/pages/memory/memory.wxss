.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #F3F0FC 0%, #E8E0F8 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  justify-content: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #5E35B1;
}

.score-panel {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(94, 53, 177, 0.08);
}

.score-item {
  display: flex;
  align-items: center;
}

.score-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.score-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #7E57C2;
}

.score-divider {
  width: 4rpx;
  height: 48rpx;
  background: #EDE7F6;
  margin: 0 36rpx;
}

.card-grid {
  margin-top: 36rpx;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.card {
  height: 190rpx;
  perspective: 800rpx;
}

.card-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.35s ease;
}

.card-flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  backface-visibility: hidden;
  box-shadow: 0 6rpx 16rpx rgba(94, 53, 177, 0.12);
}

.card-back {
  background: linear-gradient(160deg, #B39DDB 0%, #9575CD 100%);
  font-size: 64rpx;
}

.card-front {
  background: #ffffff;
  font-size: 84rpx;
  transform: rotateY(180deg);
}

.card-matched {
  background: #EDE7F6;
  border: 4rpx solid #B39DDB;
}

.card-shake {
  animation: cardShake 0.45s ease;
}

@keyframes cardShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
