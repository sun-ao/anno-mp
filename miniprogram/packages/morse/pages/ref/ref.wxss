.page {
  padding: 24rpx 24rpx 60rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: #f4f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}
.hero {
  background: linear-gradient(135deg, #00695C, #00897B);
  border-radius: 20rpx;
  padding: 32rpx 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.86; margin-top: 8rpx; }

.section { margin-bottom: 28rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #37474F;
  margin: 8rpx 4rpx 16rpx;
}

.code-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.code-cell {
  width: calc((100% - 70rpx) / 6);
  box-sizing: border-box;
  background: #fff;
  border-radius: 14rpx;
  padding: 14rpx 6rpx;
  text-align: center;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
  transition: transform 0.08s, background 0.12s;
}
/* 含短语的组（如 HELLO）改用 3 列宽格，给长文字留足空间 */
.code-grid.wide .code-cell {
  width: calc((100% - 28rpx) / 3);
}
.code-cell.active {
  background: #00695C;
  transform: scale(1.04);
}
.code-cell.active .code-ch,
.code-cell.active .code-morse { color: #fff; }
.code-ch {
  font-size: 34rpx;
  font-weight: 700;
  color: #00695C;
  line-height: 1.1;
  word-break: break-all;
  overflow-wrap: break-word;
}
.code-morse {
  font-size: 20rpx;
  color: #78909C;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.conv-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
}
.conv-label { font-size: 26rpx; color: #455A64; font-weight: 600; margin-bottom: 12rpx; }
.conv-input {
  width: 100%;
  min-height: 80rpx;
  background: #F1F4F6;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.conv-out {
  margin-top: 14rpx;
  min-height: 48rpx;
  font-size: 30rpx;
  color: #00695C;
  letter-spacing: 2rpx;
  word-break: break-all;
  font-family: Menlo, Consolas, monospace;
}
.conv-btn {
  margin-top: 16rpx;
  background: #00695C;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 6rpx 0;
}
.conv-tip {
  font-size: 22rpx;
  color: #90A4AE;
  line-height: 1.6;
  margin: 4rpx 6rpx 0;
}

/* 手指解码入口卡片 */
.cta {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E0F2F1, #B2DFDB);
  border: 2rpx solid #4DB6AC;
  margin-bottom: 18rpx;
}
.cta-hover { opacity: 0.85; }
.cta-icon {
  font-size: 56rpx;
  margin-right: 18rpx;
  line-height: 1;
}
.cta-main { flex: 1; }
.cta-title { font-size: 30rpx; font-weight: 700; color: #004D40; }
.cta-sub { font-size: 22rpx; color: #00695C; margin-top: 6rpx; line-height: 1.5; }
.cta-arrow {
  font-size: 48rpx;
  color: #00695C;
  margin-left: 8rpx;
  font-weight: 700;
}
