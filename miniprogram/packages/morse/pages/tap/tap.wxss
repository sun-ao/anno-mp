.page {
  padding: 24rpx 24rpx 60rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: #f4f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}
.hero {
  background: linear-gradient(135deg, #00695C, #00897B);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 22rpx; opacity: 0.88; margin-top: 8rpx; line-height: 1.5; }

.tap-area {
  position: relative;
  height: 400rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 4rpx solid #B2DFDB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,105,92,0.08);
  /* 只用 transform(合成层) / background / border(平涂) 过渡；不碰 box-shadow，避免真机逐帧重绘阴影卡顿 */
  transition: background 0.1s, border-color 0.1s, transform 0.06s;
  will-change: transform;
  user-select: none;
  overflow: hidden;
}
.tap-area.pressing {
  background: #E0F2F1;
  border-color: #00695C;
  transform: scale(0.99);
  /* 不再改变 box-shadow，避免大阴影重绘 */
}
/* 按压时的发光环：用 opacity + scale（皆走 GPU 合成，不触发重绘） */
.tap-area .ring {
  position: absolute;
  left: 50%;
  top: 50%;
  margin-left: -130rpx;
  margin-top: -130rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(0,105,92,0.28);
  opacity: 0;
  transform: scale(0.5);
  transition: opacity 0.1s, transform 0.3s ease-out;
  will-change: transform, opacity;
}
.tap-area.pressing .ring {
  opacity: 1;
  transform: scale(1.45);
}
/* 最近一次输入的点/划配色，常驻提示 */
.tap-area.is-dot { border-color: #26A69A; }
.tap-area.is-dash { border-color: #FF8F00; }
.tap-hint { font-size: 30rpx; color: #455A64; font-weight: 600; z-index: 1; }
.tap-sign {
  font-size: 130rpx;
  line-height: 1;
  color: #00695C;
  margin: 10rpx 0;
  font-weight: 700;
  z-index: 1;
}
.tap-sign .rec { color: #FF5252; animation: blink 0.7s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.35} }
.tap-tip { font-size: 22rpx; color: #90A4AE; z-index: 1; }

.state {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin: 24rpx 0;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
}
.state-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.state-row + .state-row { border-top: 1rpx solid #EEF2F4; }
.state-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #90A4AE;
  flex-shrink: 0;
}
.state-symbols {
  font-size: 40rpx;
  color: #00695C;
  letter-spacing: 4rpx;
  font-family: Menlo, Consolas, monospace;
  margin-right: 16rpx;
}
.state-cur {
  font-size: 30rpx;
  color: #37474F;
}
.state-text {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  color: #263238;
  word-break: break-all;
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.btn {
  flex: 1;
  min-width: 150rpx;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 12rpx 0;
  line-height: 1.4;
  box-sizing: border-box;
  margin: 0;
}
/* 去掉微信 <button> 默认的 ::after 灰边，避免和我们自定义描边叠加 */
.btn::after { border: none; }
.btn.primary { background: #00695C; color: #fff; }
.btn.ghost { background: #fff; color: #00695C; border: 2rpx solid #B2DFDB; }

.foot-tip {
  font-size: 22rpx;
  color: #90A4AE;
  line-height: 1.6;
  text-align: center;
}
