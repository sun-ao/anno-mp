<view class="page">
  <view class="title-area">
    <view class="title">找数字</view>
    <view class="subtitle">在格子里找出这个数字</view>
  </view>
  <view class="counter">找到 {{count}} 次</view>
  <view class="score-clear" bindtap="onClear">清空</view>
  <view class="ask">
    <text class="ask-label">找出</text>
    <view class="ask-num">{{target}}</view>
  </view>
  <view class="grid">
    <view wx:for="{{grid}}" wx:key="index"
      class="cell {{shakeIdx === index ? 'cell-shake' : ''}}"
      data-idx="{{index}}" bindtap="onTapCell">
      <text class="cell-num">{{item}}</text>
    </view>
  </view>
  <view class="tip">数字藏在格子里，看准再点～</view>
</view>
