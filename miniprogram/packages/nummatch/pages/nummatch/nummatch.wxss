.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EEF0FB 0%, #DDE2F8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.count-panel {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.75);
  padding: 14rpx 40rpx;
  border-radius: 60rpx;
}

.count-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #4F5BD5;
}

.count-label {
  font-size: 38rpx;
}

.obj-area {
  margin-top: 70rpx;
  min-height: 240rpx;
  position: relative;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.obj {
  line-height: 1;
}

.obj-xl { font-size: 180rpx; }
.obj-lg { font-size: 140rpx; }
.obj-md { font-size: 116rpx; }
.obj-sm { font-size: 94rpx; }
.obj-xs { font-size: 80rpx; }
.obj-s2 { font-size: 70rpx; }
.obj-s3 { font-size: 62rpx; }
.obj-s4 { font-size: 54rpx; }

.burst {
  position: absolute;
  top: -40rpx;
  font-size: 120rpx;
  animation: burstPop 0.9s ease forwards;
}

@keyframes burstPop {
  0% { transform: scale(0); opacity: 0; }
  30% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(1); opacity: 0; }
}

.opt-row {
  margin-top: auto;
  display: flex;
  gap: 40rpx;
}

.opt {
  width: 180rpx;
  height: 180rpx;
  border-radius: 44rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 0 #C7CDEF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
  font-weight: 800;
  color: #4F5BD5;
}

.opt:active {
  transform: scale(0.94);
}

.opt-correct {
  background: #34C77B;
  color: #FFFFFF;
  box-shadow: 0 10rpx 0 #279A5F;
  animation: optPop 0.45s ease;
}

@keyframes optPop {
  0% { transform: scale(1); }
  40% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

.opt-shake {
  animation: optShake 0.4s ease;
}

@keyframes optShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-16rpx); }
  40% { transform: translateX(16rpx); }
  60% { transform: translateX(-12rpx); }
  80% { transform: translateX(12rpx); }
}

.tip {
  margin-top: 40rpx;
  font-size: 34rpx;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
