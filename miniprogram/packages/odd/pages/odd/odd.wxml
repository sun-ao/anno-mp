<view class="page">
  <view class="title-area">
    <text class="title">找不同</text>
  </view>

  <view class="count-panel">
    <text class="count-emoji">⭐</text>
    <text class="count-num">{{count}}</text>
    <view class="score-clear" bindtap="onClear">清空</view>
  </view>

  <view class="grid">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="cell {{foundId === item.id ? 'cell-found' : ''}} {{shakeId === item.id ? 'cell-shake' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapItem"
    >
      <text class="cell-emoji {{foundId === item.id ? 'revealed' : ''}}">{{item.emoji}}</text>
    </view>
  </view>
</view>
