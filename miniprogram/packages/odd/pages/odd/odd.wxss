.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #FFF6EC 0%, #FFEAD1 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  justify-content: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #E65100;
}

.count-panel {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(230, 81, 0, 0.08);
}

.count-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.count-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #F57C00;
}

.grid {
  margin-top: 40rpx;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.cell {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(230, 81, 0, 0.08);
}

.cell-emoji {
  font-size: 96rpx;
  line-height: 1;
  /* 默认灰黑色：颜色一致，只靠形状区分（与影子/形状配对一致） */
  filter: grayscale(1) brightness(0.35);
}

.revealed {
  filter: none;
}

.cell-found {
  background: #FFE0B2;
  border: 4rpx solid #FFB74D;
  animation: foundPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.cell-shake {
  animation: cellShake 0.45s ease;
}

@keyframes foundPop {
  0% { transform: scale(1); }
  40% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

@keyframes cellShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
