<view class="page">
  <view class="count-panel">
    <text class="count-emoji">⭐</text>
    <text class="count-num">{{count}}</text>
    <view class="score-clear" bindtap="onClear">清空</view>
  </view>

  <view class="seq-card">
    <view class="seq-row">
      <view
        wx:for="{{sequence}}"
        wx:key="index"
        class="seq-item {{index === blankIndex ? (solved ? 'seq-filled' : 'seq-blank') : ''}}"
      >{{index === blankIndex ? (solved ? answer : '❓') : item}}</view>
    </view>
  </view>

  <view class="option-row">
    <view
      wx:for="{{options}}"
      wx:key="index"
      class="option-card {{shakeIndex === index ? 'shake' : ''}}"
      data-idx="{{index}}"
      bindtap="onTapOption"
    >
      <view class="option-emoji">{{item}}</view>
    </view>
  </view>
</view>
