.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #EFF9F0 0%, #DEF2E0 100%);
  padding: 48rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.count-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 60, 0.1);
}

.count-emoji {
  font-size: 48rpx;
}

.count-num {
  margin-left: 16rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #2F7D3B;
}

.seq-card {
  margin-top: 56rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 36rpx 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(46, 125, 60, 0.12);
}

.seq-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.seq-item {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  line-height: 1;
}

.seq-blank {
  background: #EFF9F0;
  border: 4rpx dashed #7BC47F;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.seq-filled {
  border-style: solid;
  border-color: #3FA34D;
  background: #ffffff;
  animation: popIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.option-row {
  margin-top: 64rpx;
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 48rpx;
}

.option-card {
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 60, 0.1);
}

.option-emoji {
  font-size: 130rpx;
  line-height: 1.2;
}

.shake {
  animation: shakeX 0.45s ease;
}

@keyframes popIn {
  from { transform: scale(0.3); }
  to { transform: scale(1); }
}

@keyframes shakeX {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  40% { transform: translateX(14rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
