<view class="page">
  <view class="title-area">
    <text class="title">躲猫猫</text>
    <text class="subtitle">{{phase === 'peek' ? '先记住小动物藏在哪 👀' : (phase === 'shuffle' ? '遮挡物长得一样，看准它挪到了哪～' : '它现在躲在哪后面？点一下！')}}</text>
  </view>

  <view class="found-panel">
    <text class="found-num">{{found}}</text>
    <text class="found-label">找到的小动物</text>
  </view>

  <view class="spot-grid">
    <view
      wx:for="{{spots}}"
      wx:key="id"
      class="spot {{shakeId === index ? 'spot-shake' : ''}}"
      style="{{flipStyles[item.id]}}"
      data-idx="{{index}}"
      bindtap="onTapSpot"
    >
      <view class="spot-animal {{(phase === 'peek' && item.hasAnimal) || revealId === index ? 'animal-out' : ''}}">{{item.animal}}</view>
      <view class="spot-cover {{phase === 'shuffle' ? 'cover-wobble' : ''}} {{(phase === 'peek' && item.hasAnimal) || revealId === index ? 'cover-lift' : ''}}">{{item.cover}}</view>
    </view>
  </view>

  <view class="actions">
    <view wx:if="{{phase === 'peek'}}" class="btn" bindtap="onStartShuffle">我记住了，开始 ➡️</view>
    <view wx:if="{{phase === 'guess'}}" class="tip">点一个看看对不对</view>
  </view>
</view>
