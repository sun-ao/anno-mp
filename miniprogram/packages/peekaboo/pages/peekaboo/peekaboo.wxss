.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFBEA 0%, #FBF3D5 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #8A6A1B;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #C0A24A;
}

.found-panel {
  margin: 40rpx auto 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 72rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.found-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #D99A1B;
}

.found-label {
  font-size: 24rpx;
  color: #B99A5A;
}

.spot-grid {
  margin-top: 48rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26rpx;
}

.spot {
  height: 200rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.spot-shake {
  animation: spotShake 0.45s ease;
}

@keyframes spotShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

.spot-animal {
  position: absolute;
  bottom: 20rpx;
  font-size: 100rpx;
  transform: scale(0);
  z-index: 1;
}

.animal-out {
  animation: animalOut 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes animalOut {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

.spot-cover {
  position: relative;
  font-size: 120rpx;
  z-index: 2;
  transition: transform 0.35s ease, opacity 0.35s ease;
}

/* 洗牌阶段：所有遮挡物一起轻微晃动，配合多次位置重排，呈现「变换了几次」的观感 */
.cover-wobble {
  animation: coverWobble 0.5s ease-in-out infinite;
}

@keyframes coverWobble {
  0%, 100% { transform: rotate(-7deg) scale(1); }
  50% { transform: rotate(7deg) scale(1.08); }
}

.cover-lift {
  transform: translateY(-60rpx) rotate(-8deg);
  opacity: 0.15;
}

.tip {
  margin-top: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #B9A24A;
}

.actions {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.btn {
  padding: 22rpx 60rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #8A6A1B;
  box-shadow: 0 8rpx 22rpx rgba(138, 106, 27, 0.16);
}

.btn:active {
  transform: scale(0.95);
}
