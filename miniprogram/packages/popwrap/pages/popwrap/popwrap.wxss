.page {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #F0FBF9 0%, #E1F5F1 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1B7A6E;
}

.target-tip {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #1B7A6E;
  font-weight: 600;
}

.target-name {
  font-weight: 800;
  margin: 0 4rpx;
}

.target-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: inline-block;
  vertical-align: middle;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.18);
  margin: 0 8rpx;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  margin-top: 48rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.07);
}

.cell {
  width: 20%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx;
}

.bubble {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.18), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.06);
}

.bubble:active {
  transform: scale(0.9);
}

/* 5 种随机颜色（也用于顶部目标色点） */
.c-red {
  background: radial-gradient(circle at 32% 28%, #FFB3B3, #FF6B6B 70%);
}

.c-yellow {
  background: radial-gradient(circle at 32% 28%, #FFE89A, #FFD93D 70%);
}

.c-green {
  background: radial-gradient(circle at 32% 28%, #B8F1C6, #6BCB77 70%);
}

.c-blue {
  background: radial-gradient(circle at 32% 28%, #A9C9FF, #4D96FF 70%);
}

.c-purple {
  background: radial-gradient(circle at 32% 28%, #DCC2FF, #B983FF 70%);
}

/* 捏破后变灰扁（放在颜色类之后，确保覆盖背景色） */
.bubble-flat {
  background: #E8F2F0;
  box-shadow: inset 0 6rpx 12rpx rgba(0, 0, 0, 0.08);
  transform: scale(0.9);
}

.stat-row {
  width: 100%;
  box-sizing: border-box;
  margin-top: 40rpx;
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.stat-left,
.stat-right {
  font-size: 28rpx;
  color: #4C9A8F;
  font-weight: 600;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
