<view class="page">
  <view class="stat-row">
    <text class="stat">⭐ {{total}}</text>
    <view class="score-clear" bindtap="onClear">清空</view>
    <text wx:if="{{done}}" class="done-flag">🎉</text>
  </view>

  <view class="board">
    <view
      wx:for="{{slots}}"
      wx:key="id"
      class="slot {{item.placed ? 'slot-filled' : ''}} {{shakeSlotId === item.id ? 'shake' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapSlot"
    >
      <text wx:if="{{item.placed}}" class="slot-emoji">{{item.expect}}</text>
      <text wx:else class="slot-ghost">{{item.expect}}</text>
    </view>
  </view>

  <view class="pieces">
    <view
      wx:for="{{pieces}}"
      wx:key="id"
      class="piece {{item.placed ? 'piece-gone' : ''}} {{selectedPiece === item.id ? 'piece-selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapPiece"
    >
      <text class="piece-emoji">{{item.emoji}}</text>
    </view>
  </view>
</view>
