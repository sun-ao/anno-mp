.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8EAF6 0%, #C5CAE9 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #283593;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #5C6BC0;
}

.panel-row {
  margin: 40rpx auto 0;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.stat-panel {
  flex: 1;
  max-width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #283593;
  line-height: 1.2;
}

.stat-num.time {
  font-size: 44rpx;
  color: #D9534F;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7986CB;
}

.field {
  margin-top: 40rpx;
  position: relative;
  height: 1020rpx;
  background: linear-gradient(180deg, #1A237E 0%, #3949AB 100%);
  border-radius: 32rpx;
  overflow: hidden;
}

/* 背景装饰天体：缓慢闪烁 */
.deco {
  position: absolute;
  opacity: 0.35;
  font-size: 44rpx;
  line-height: 1;
  animation: glow 2.4s ease-in-out infinite;
}

.d1 { top: 120rpx; left: 60rpx; }
.d2 { top: 320rpx; right: 80rpx; animation-delay: 0.8s; }
.d3 { top: 500rpx; left: 100rpx; animation-delay: 1.6s; }
.d4 { top: 240rpx; right: 140rpx; animation-delay: 0.4s; }

@keyframes glow {
  0%, 100% { opacity: 0.18; }
  50% { opacity: 0.5; }
}

/* 掉落的天体 */
.item {
  position: absolute;
  font-size: 96rpx;
  line-height: 1;
}

/* 接住时 "+1" 飘字 */
.pop {
  position: absolute;
  font-size: 44rpx;
  font-weight: 800;
  color: #FFE082;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.4);
  animation: floatUp 0.8s ease-out forwards;
  pointer-events: none;
}

@keyframes floatUp {
  from { transform: translateY(0); opacity: 1; }
  to { transform: translateY(-90rpx); opacity: 0; }
}

/* 接收器：张开的手掌 */
.catcher {
  position: absolute;
  top: 860rpx;
  width: 140rpx;
  font-size: 130rpx;
  line-height: 1;
  text-align: center;
}

/* 暂停覆盖层 */
.pause-cover {
  position: absolute;
  inset: 0;
  background: rgba(26, 35, 126, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.pause-emoji {
  font-size: 120rpx;
  animation: wobble 0.6s ease-in-out infinite;
}

@keyframes wobble {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
}

.pause-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #FFE082;
}

.pause-count {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.win-cover {
  position: absolute;
  inset: 0;
  background: rgba(26, 35, 126, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 4;
}

.win-emoji {
  font-size: 160rpx;
}

.win-text {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #FFE082;
}

.win-sub {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
