<view class="page" bindtap="onTap">
  <!-- ===== 设置态：模式 + 人数 ===== -->
  <block wx:if="{{phase === 'setup'}}">
    <view class="hero">
      <text class="hero-title">猜拳淘汰赛</text>
      <text class="hero-sub">轮流点屏随机出拳，全员出齐再结算，最后的赢家胜出</text>
    </view>

    <view class="section-label">玩法模式</view>
    <view class="mode-row">
      <view class="mode-btn {{mode === 'rps' ? 'mode-active' : ''}}" data-mode="rps" bindtap="onSelectMode">
        <text class="mode-name">猜拳</text>
        <text class="mode-desc">石头剪刀布 · 轮流随机出</text>
      </view>
      <view class="mode-btn {{mode === 'hh' ? 'mode-active' : ''}}" data-mode="hh" bindtap="onSelectMode">
        <text class="mode-name">手心手背</text>
        <text class="mode-desc">少数派出局</text>
      </view>
    </view>

    <view class="section-label">参与人数</view>
    <view class="count-row">
      <view
        wx:for="{{countOptions}}"
        wx:key="*this"
        class="count-chip {{playerCount === item ? 'count-active' : ''}}"
        data-n="{{item}}"
        bindtap="onSelectCount"
      >
        <text class="count-text">{{item}}</text>
      </view>
    </view>

    <view class="start-btn" catchtap="onStart">开始</view>
  </block>

  <!-- ===== 进行中：轮流点屏 ===== -->
  <block wx:elif="{{phase === 'playing'}}">
    <view class="info-bar">
      <text class="info-round">第 {{round}} 轮</text>
      <text class="info-alive">剩 {{aliveCount}} 人</text>
    </view>

    <view class="tap-zone">
      <text class="tap-title">轮到</text>
      <text class="tap-name">玩家 {{turnIndex + 1}}</text>
      <text class="tap-hint">{{mode === 'rps' ? '点击屏幕随机出拳，全员出齐再结算' : '点击屏幕，随机出手心或手背'}}</text>
    </view>

    <view wx:if="{{lastResult}}" class="result-card">
      <view class="hand-show">
        <text class="hand-emoji">{{lastResult.gesture.emoji || lastResult.hand.emoji}}</text>
        <text class="hand-text">{{lastResult.gesture ? '玩家 ' + (lastResult.turn + 1) + ' 出了 ' + lastResult.gesture.name : lastResult.hand.name}}</text>
      </view>
    </view>
  </block>

  <!-- ===== 轮次结束 ===== -->
  <block wx:elif="{{phase === 'roundEnd'}}">
    <view class="center-zone">
      <text class="center-title">第 {{round}} 轮结束</text>
      <text class="center-summary">{{roundSummary}}</text>
      <view wx:if="{{roundResult}}" class="result-grid">
        <view wx:for="{{roundResult.rows}}" wx:key="name" class="result-row {{item.out ? 'result-out' : 'result-win'}}">
          <text class="result-emoji">{{item.emoji}}</text>
          <text class="result-name">{{item.name}}</text>
          <text class="result-tag">{{item.out ? '出局' : '晋级'}}</text>
        </view>
      </view>
      <text class="center-hint">点击屏幕进入下一轮</text>
    </view>
  </block>

  <!-- ===== 胜者 ===== -->
  <block wx:else>
    <view class="center-zone">
      <text class="winner-crown">🏆</text>
      <text class="center-title">胜者是</text>
      <text class="winner-name">玩家 {{winner + 1}}</text>
      <text class="center-hint">点击屏幕再来一局</text>
    </view>
  </block>
</view>
