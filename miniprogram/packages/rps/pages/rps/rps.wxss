.page {
  min-height: 100vh;
  background: #f6f7f9;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 设置态 ===== */

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2E2C4A;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #888888;
  text-align: center;
  line-height: 1.6;
}

.section-label {
  font-size: 26rpx;
  color: #888780;
  margin: 0 8rpx 16rpx;
}

.mode-row {
  display: flex;
  margin-bottom: 40rpx;
}

.mode-btn {
  flex: 1;
  margin: 0 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 4rpx solid transparent;
}

.mode-btn:first-child {
  margin-left: 0;
}

.mode-btn:last-child {
  margin-right: 0;
}

.mode-btn:active {
  opacity: 0.8;
}

.mode-active {
  border-color: #2E6BE6;
  background: #EFF4FE;
}

.mode-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2E2C4A;
}

.mode-active .mode-name {
  color: #2E6BE6;
}

.mode-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999999;
}

.count-row {
  display: flex;
  flex-wrap: wrap;
}

.count-chip {
  width: 96rpx;
  height: 96rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
}

.count-chip:active {
  opacity: 0.8;
}

.count-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #2E2C4A;
}

.count-active {
  border-color: #2E6BE6;
  background: #EFF4FE;
}

.count-active .count-text {
  color: #2E6BE6;
}

.start-btn {
  margin-top: 48rpx;
  padding: 26rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5B8DEF 0%, #2E6BE6 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(46, 107, 230, 0.3);
}

.start-btn:active {
  opacity: 0.85;
}

/* ===== 进行中 ===== */

.info-bar {
  display: flex;
  justify-content: center;
  align-items: center;
}

.info-round {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E6BE6;
  background: #EFF4FE;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
}

.info-alive {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
}

.tap-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tap-title {
  font-size: 26rpx;
  color: #999999;
  letter-spacing: 6rpx;
}

.tap-name {
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #2E2C4A;
}

.tap-hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #B0B0B0;
  letter-spacing: 2rpx;
}

/* 出手结果 */
.result-card {
  margin-bottom: 60rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  animation: resultPop 0.3s ease-out;
}

@keyframes resultPop {
  0% {
    transform: scale(0.6);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 本轮结算：每个人的出手 */
.result-grid {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.result-row {
  width: 200rpx;
  margin: 12rpx;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-out {
  background: #FDECEA;
}

.result-win {
  background: #E7F6EF;
}

.result-emoji {
  font-size: 64rpx;
  line-height: 1.2;
}

.result-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #2E2C4A;
}

.result-tag {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.result-out .result-tag {
  color: #C0392B;
}

.result-win .result-tag {
  color: #0F6E56;
}

.hand-show {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hand-emoji {
  font-size: 100rpx;
  line-height: 1.2;
}

.hand-text {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2E2C4A;
}

/* ===== 轮次结束 / 胜者 ===== */

.center-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.center-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2E2C4A;
}

.center-summary {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #666666;
  text-align: center;
  line-height: 1.7;
}

.center-hint {
  margin-top: 48rpx;
  font-size: 26rpx;
  color: #B0B0B0;
}

.winner-crown {
  font-size: 120rpx;
  line-height: 1.2;
  margin-bottom: 32rpx;
}

.winner-name {
  margin-top: 16rpx;
  font-size: 80rpx;
  font-weight: 700;
  color: #2E6BE6;
}
