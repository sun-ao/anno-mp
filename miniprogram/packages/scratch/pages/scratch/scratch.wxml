<view class="page">
  <view class="title-area">
    <text class="title">刮刮乐</text>
    <text class="subtitle">手指刮开涂层，看看今天的好运气</text>
  </view>

  <view class="card">
    <view class="prize">
      <text class="prize-emoji">{{prize.emoji}}</text>
      <text class="prize-text">{{prize.text}}</text>
    </view>
    <canvas type="2d" id="scratch" class="scratch"
      bindtouchstart="onTouch"
      bindtouchmove="onTouch"
      bindtouchend="onTouch"></canvas>
  </view>

  <view class="actions">
    <view class="btn" bindtap="onAgain">再来一张</view>
  </view>
</view>
