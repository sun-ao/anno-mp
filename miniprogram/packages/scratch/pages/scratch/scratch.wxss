.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E0F7F4 0%, #C8EFE8 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #00897B;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4FA89B;
  text-align: center;
}

.card {
  position: relative;
  width: 600rpx;
  height: 360rpx;
  margin-top: 48rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(0, 137, 123, 0.2);
}

.prize {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF3E0 100%);
}

.prize-emoji {
  font-size: 120rpx;
  line-height: 1.2;
}

.prize-text {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #C67113;
}

.scratch {
  position: absolute;
  left: 0;
  top: 0;
  width: 600rpx;
  height: 360rpx;
}

.actions {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.btn {
  padding: 22rpx 64rpx;
  background: #00897B;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(0, 137, 123, 0.3);
}

.btn:active {
  transform: scale(0.95);
}
