<view class="page">
  <view class="count-panel">
    <text class="count-emoji">⭐</text>
    <text class="count-num">{{count}}</text>
    <view class="score-clear" bindtap="onClear">清空</view>
  </view>

  <view class="target-card">
    <view class="target-emoji">{{target}}</view>
  </view>

  <view class="arrow">👇</view>

  <view class="shadow-row">
    <view
      wx:for="{{options}}"
      wx:key="index"
      class="shadow-card {{shakeIndex === index ? 'shake' : ''}}"
      data-idx="{{index}}"
      bindtap="onTapOption"
    >
      <view class="shadow-emoji {{foundIndex === index ? 'found' : ''}}">{{item}}</view>
    </view>
  </view>
</view>
