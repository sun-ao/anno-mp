.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #F0F2F5 0%, #E1E6EE 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.count-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(40, 55, 80, 0.08);
}

.count-emoji {
  font-size: 48rpx;
}

.count-num {
  margin-left: 16rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #3D4A5C;
}

.target-card {
  margin-top: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 32rpx 88rpx;
  box-shadow: 0 10rpx 28rpx rgba(40, 55, 80, 0.1);
}

.target-emoji {
  font-size: 150rpx;
  line-height: 1.2;
}

.arrow {
  margin-top: 24rpx;
  font-size: 56rpx;
}

.shadow-row {
  margin-top: 40rpx;
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 32rpx;
}

.shadow-card {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(40, 55, 80, 0.08);
}

.shadow-emoji {
  font-size: 110rpx;
  line-height: 1.2;
  filter: grayscale(1) brightness(0.35);
}

.found {
  filter: none;
  animation: popIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.shake {
  animation: shakeX 0.45s ease;
}

@keyframes popIn {
  from { transform: scale(0.3); }
  to { transform: scale(1); }
}

@keyframes shakeX {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  40% { transform: translateX(14rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
