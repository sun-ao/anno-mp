.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EFF4FE 0%, #DFE9FC 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.counter {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 60rpx;
  padding: 12rpx 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(66, 103, 178, 0.16);
}

.counter-star {
  font-size: 44rpx;
}

.counter-num {
  margin-left: 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #4267B2;
}

.target-card {
  margin-top: 60rpx;
  width: 320rpx;
  height: 320rpx;
  background: #ffffff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 36rpx rgba(66, 103, 178, 0.16);
}

.target-emoji {
  font-size: 190rpx;
  line-height: 1;
}

.options {
  margin-top: 80rpx;
  display: flex;
  justify-content: space-between;
  width: 100%;
}

.option {
  width: 200rpx;
  height: 200rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(66, 103, 178, 0.14);
}

.option:active {
  transform: scale(0.93);
}

.option-emoji {
  font-size: 120rpx;
  line-height: 1;
  /* 默认灰黑色，类似影子配对：答对时揭晓彩色 */
  filter: grayscale(1) brightness(0.35);
}

.revealed {
  filter: none;
}

.option-pop {
  animation: option-pop 0.45s ease;
}

@keyframes option-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.25); }
  70% { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.option-shake {
  animation: option-shake 0.4s ease;
}

@keyframes option-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
