<view class="page">
  <view class="title-area">
    <view class="title">记顺序</view>
    <view class="subtitle">{{state === 'show' ? '看好亮灯的顺序' : (over ? '记错啦，再来一次' : '照着刚才的顺序点')}}</view>
  </view>

  <view class="diff-row">
    <view wx:for="{{diffs}}" wx:key="key"
      class="diff-btn {{difficulty === item.key ? 'diff-on' : ''}}"
      data-diff="{{item.key}}" bindtap="onSwitchDiff">{{item.name}} {{item.cols}}×{{item.cols}}</view>
  </view>

  <view class="counter-row">
    <view class="counter">闯过 {{count}} 关 · 第 {{round}} 步</view>
    <view class="score-clear" bindtap="onClear">清空</view>
  </view>

  <view class="pad-grid" style="grid-template-columns: repeat({{cols}}, 1fr); grid-template-rows: repeat({{cols}}, 1fr);">
    <view wx:for="{{pads}}" wx:key="id"
      class="spad {{lit === item.id ? 'spad-lit' : ''}}"
      style="background:{{item.color}}"
      data-id="{{item.id}}" bindtap="onTapPad">
      <text wx:if="{{lit === item.id && litIndex > 0}}" class="spad-tag">{{litIndex}}</text>
    </view>
  </view>

  <view wx:if="{{over}}" class="over-btn" bindtap="onAgain">重新开始</view>
  <view wx:elif="{{state === 'input'}}" class="replay-btn" bindtap="onReplay">↺ 重看一遍</view>
  <view class="tip">灯会依次亮起并标上序号，记好第几个、什么颜色，再照顺序点～</view>
</view>
