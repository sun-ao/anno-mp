.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F3ECE2 0%, #E2D3BF 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #6D4C41;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #9C7A68;
}

.diff-row {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.diff-btn {
  font-size: 26rpx;
  font-weight: 700;
  color: #6D4C41;
  background: rgba(255, 255, 255, 0.7);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.diff-on {
  background: #6D4C41;
  color: #fff;
  border-color: #6D4C41;
}

.counter {
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #6D4C41;
  background: #ffffff;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.pad-grid {
  margin-top: 56rpx;
  width: 600rpx;
  height: 600rpx;
  display: grid;
  gap: 18rpx;
}

.spad {
  position: relative;
  border-radius: 32rpx;
  opacity: 0.42;
  filter: saturate(0.55) brightness(0.62);
  box-shadow: inset 0 0 0 6rpx rgba(0, 0, 0, 0.14);
  transition: opacity 0.08s, transform 0.08s, filter 0.08s;
}

.spad-lit {
  opacity: 1;
  filter: none;
  transform: scale(1.1);
  box-shadow: 0 0 0 10rpx rgba(255, 255, 255, 0.9),
              0 0 56rpx 10rpx rgba(255, 255, 255, 0.95),
              inset 0 0 0 6rpx rgba(255, 255, 255, 0.7);
  animation: spadPulse 0.45s ease-in-out;
}

@keyframes spadPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.14); }
  100% { transform: scale(1.1); }
}

.spad-tag {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #6D4C41;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.over-btn {
  margin-top: 56rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: #6D4C41;
  padding: 18rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(109, 76, 65, 0.3);
}

.replay-btn {
  margin-top: 56rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #6D4C41;
  background: rgba(255, 255, 255, 0.85);
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  border: 2rpx solid #6D4C41;
  box-shadow: 0 6rpx 16rpx rgba(109, 76, 65, 0.18);
}

.tip {
  margin-top: 48rpx;
  font-size: 26rpx;
  color: #9C7A68;
  text-align: center;
  padding: 0 24rpx;
}

.counter-row {
  display: flex;
  align-items: center;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
  margin-top: 28rpx;
}
