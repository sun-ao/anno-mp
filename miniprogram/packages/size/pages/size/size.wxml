<view class="page">
  <view class="stat-row">
    <text class="stat">⭐ {{total}}</text>
    <view class="score-clear" bindtap="onClear">清空</view>
    <text wx:if="{{done}}" class="done-flag">🎉</text>
  </view>

  <view class="items">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="item {{item.placed ? 'item-gone' : ''}} {{shakeId === item.id ? 'shake' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapItem"
    >
      <text class="item-emoji" style="font-size: {{item.fs}}">{{item.emoji}}</text>
    </view>
  </view>

  <view class="stands-row">
    <view wx:for="{{stands}}" wx:key="size" class="stand-wrap">
      <text wx:if="{{item.filled}}" class="stand-emoji" style="font-size: {{item.fs}}">{{item.emoji}}</text>
      <view class="stand stand-{{item.size}} {{nextSize === item.size && !done ? 'stand-next' : ''}}"></view>
    </view>
  </view>
</view>
