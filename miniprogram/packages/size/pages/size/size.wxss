.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF5E9 0%, #F6EBD3 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-height: 56rpx;
}

.stat {
  font-size: 36rpx;
  font-weight: 700;
  color: #C08A2D;
}

.done-flag {
  font-size: 44rpx;
}

.items {
  margin-top: 28rpx;
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-evenly;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.07);
}

.item {
  min-width: 160rpx;
  min-height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.item:active {
  transform: scale(0.92);
}

.item-gone {
  visibility: hidden;
}

.item-emoji {
  line-height: 1;
}

.stands-row {
  margin-top: 64rpx;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-evenly;
}

.stand-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-height: 380rpx;
}

.stand-emoji {
  line-height: 1;
  margin-bottom: 12rpx;
}

.stand {
  border-radius: 24rpx 24rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #F5C97B 0%, #E0A54D 100%);
  box-shadow: 0 8rpx 20rpx rgba(224, 165, 77, 0.35);
}

.stand-1 {
  width: 150rpx;
  height: 70rpx;
}

.stand-2 {
  width: 190rpx;
  height: 110rpx;
}

.stand-3 {
  width: 230rpx;
  height: 150rpx;
}

.stand-next {
  animation: stand-pulse 1s ease-in-out infinite;
}

@keyframes stand-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.shake {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-14rpx); }
  50% { transform: translateX(12rpx); }
  75% { transform: translateX(-8rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
