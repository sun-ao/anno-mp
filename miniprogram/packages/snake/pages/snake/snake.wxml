<view class="page">
  <view class="tabs">
    <view class="tab {{mode === 'library' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="library" hover-class="hv">造型库</view>
    <view class="tab {{mode === 'guide' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="guide" hover-class="hv">跟着折</view>
    <view class="tab {{mode === 'manual' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="manual" hover-class="hv">自由折</view>
  </view>

  <view class="seg-row">
    <text class="seg-label">段数</text>
    <view
      wx:for="{{segOptions}}"
      wx:key="*this"
      class="seg-pill {{segCount === item ? 'active' : ''}}"
      data-c="{{item}}"
      bindtap="onPickSeg" hover-class="hv">{{item}}</view>
  </view>

  <view class="header">
    <view class="shape-name">{{shapeName}}</view>
    <view class="shape-meta">{{metaText}}</view>
  </view>

  <view class="stage">
    <snake3d
      id="snake3d"
      turns="{{turns}}"
      pieceCount="{{pieceCount}}"
      interactive="{{interactive}}"
      overlap="{{overlap}}"
      highlight="{{highlight}}"
      spin="{{spin}}"
      scale="{{scale}}"
      focus="{{focus}}"
      nudge="{{nudge}}"
      showNumbers="{{showNumbers}}"
      bindpick="onPickPiece"
    />
    <view wx:if="{{mode === 'guide' && guideZoomTip}}" class="zoom-tip">🤏 看不清？双指捏合放大，看清折叠细节</view>
    <view class="stage-tools">
      <view class="tool-size">
        <view class="tool-toggle" bindtap="onScaleDec" hover-class="hv">－</view>
        <text class="size-label">🔍 {{scalePct}}%</text>
        <view class="tool-toggle" bindtap="onScaleInc" hover-class="hv">＋</view>
      </view>
      <view class="tool-toggle {{showNumbers ? 'on' : ''}}" bindtap="onToggleNumbers" hover-class="hv">🔢 编号</view>
      <view wx:if="{{mode === 'library'}}" class="tool-toggle {{spin ? 'on' : ''}}" bindtap="onToggleSpin" hover-class="hv">⟳ 自转</view>
    </view>
    <view wx:if="{{mode === 'manual' && overlapCount > 0}}" class="overlap-banner">⚠ 有 {{overlapCount}} 处穿模</view>
    <view wx:if="{{mode === 'guide' && !guideDone}}" class="guide-banner">
      <view class="dir-orb" style="background:{{guideColor}}">{{guideArrow}}</view>
      <view class="guide-text">
        <text class="guide-step">第 {{guideStep + 1}}/{{guideTotal}} 步</text>
        <text class="guide-dir" style="color:{{guideColor}}">{{guideDir}}</text>
        <text class="guide-word">把发光的小方块{{guideWord}}！</text>
      </view>
    </view>
    <view wx:if="{{mode === 'guide' && guideDone}}" class="guide-done">
      <text class="done-emoji">🎉</text>
      <text class="done-text">{{guideHint}}</text>
    </view>
    <view wx:if="{{mode === 'guide' && guideDone}}" class="confetti">
      <text class="cf cf1">🎊</text><text class="cf cf2">⭐</text><text class="cf cf3">🌟</text><text class="cf cf4">🎉</text><text class="cf cf5">✨</text>
    </view>
  </view>

  <!-- 造型库 -->
  <block wx:if="{{mode === 'library'}}">
    <view class="control-bar">
      <view class="ctrl-btn primary" bindtap="onTogglePlay" hover-class="hv">{{isPlaying ? '⏸ 暂停' : '▶ 播放'}}</view>
      <view class="ctrl-btn" bindtap="onEnterGuide" hover-class="hv">👶 跟着折</view>
      <view class="ctrl-btn" bindtap="onReset" hover-class="hv">↺ 直线</view>
    </view>

    <view class="speed-row">
      <text class="speed-label">速度</text>
      <view
        wx:for="{{speeds}}"
        wx:key="ms"
        class="speed-pill {{speedIndex === index ? 'active' : ''}}"
        data-i="{{index}}"
        bindtap="onPickSpeed" hover-class="hv">{{item.label}}</view>
    </view>

    <scroll-view class="preset-bar" scroll-x enable-flex>
      <view
        wx:for="{{presets}}"
        wx:key="id"
        class="preset-chip {{selectedId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapPreset" hover-class="hv">
        <text class="preset-name">{{item.name}}</text>
        <view class="star {{item.fav ? 'on' : ''}}" catchtap="onToggleFav" data-id="{{item.id}}" hover-class="hv">{{item.fav ? '★' : '☆'}}</view>
      </view>
    </scroll-view>

    <scroll-view wx:if="{{myShapes.length}}" class="preset-bar mine" scroll-x enable-flex>
      <view class="mine-tag">我的造型</view>
      <view
        wx:for="{{myShapes}}"
        wx:key="id"
        class="preset-chip mine {{selectedId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapMyShape"
        bindlongpress="onDeleteMyShape" hover-class="hv">
        <text class="preset-name">{{item.name}}</text>
        <view class="star del" catchtap="onDeleteMyShape" data-id="{{item.id}}" hover-class="hv">✕</view>
      </view>
    </scroll-view>
  </block>

  <!-- 跟着折 -->
  <block wx:if="{{mode === 'guide'}}">
    <view class="guide-progress">
      <text class="prog-emoji">🌟</text>
      <view class="guide-bar">
        <view class="guide-fill" style="width:{{guideTotal ? (guideStep / guideTotal * 100) : 0}}%"></view>
      </view>
      <text class="guide-count">{{guideStep}}/{{guideTotal}}</text>
    </view>

    <view class="control-bar guide">
      <view class="ctrl-btn" bindtap="onGuidePrev" hover-class="hv">⏮ 上一步</view>
      <view class="ctrl-btn primary" bindtap="onGuideAuto" hover-class="hv">👉 帮我折</view>
      <view class="ctrl-btn" bindtap="onGuideNext" hover-class="hv">下一步 ⏭</view>
    </view>
    <view class="ctrl-btn ghost full" bindtap="onGuideRestart" hover-class="hv">🔄 重新折一次</view>

    <scroll-view class="preset-bar" scroll-x enable-flex>
      <view
        wx:for="{{presets}}"
        wx:key="id"
        class="preset-chip {{selectedId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapPreset" hover-class="hv">
        <text class="preset-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </block>

  <!-- 自由折 -->
  <block wx:if="{{mode === 'manual'}}">
    <view class="joint-rail">
      <view
        wx:for="{{joints}}"
        wx:key="index"
        class="joint-dot state-{{item.state}} {{selectedJoint === item.index ? 'sel' : ''}}"
        data-j="{{item.index}}"
        bindtap="onTapJoint" hover-class="hv">{{item.index + 1}}</view>
    </view>

    <view class="stepper" wx:if="{{selectedJoint >= 0}}">
      <text class="stepper-title">关节 {{selectedJoint + 1}}</text>
      <view class="stepper-btns">
        <view class="step-btn" bindtap="onSetJoint" data-v="-1" hover-class="hv">↺ 左 (-1)</view>
        <view class="step-btn" bindtap="onSetJoint" data-v="0" hover-class="hv">归零</view>
        <view class="step-btn" bindtap="onSetJoint" data-v="1" hover-class="hv">右 (+1) ↻</view>
        <view class="step-btn" bindtap="onSetJoint" data-v="2" hover-class="hv">翻转 (2)</view>
      </view>
    </view>

    <view class="control-bar manual">
      <view class="ctrl-btn" bindtap="onUndo" hover-class="hv">↶ 撤销</view>
      <view class="ctrl-btn" bindtap="onReset" hover-class="hv">↺ 直线</view>
      <view class="ctrl-btn" bindtap="onRandom" hover-class="hv">🎲 随机</view>
      <view class="ctrl-btn primary" bindtap="onSave" hover-class="hv">💾 保存</view>
    </view>

    <view class="pose-row" bindtap="onCopyPose" hover-class="hv">
      <text class="pose-label">当前姿态</text>
      <text class="pose-digits">{{poseDigits}}</text>
    </view>

    <view class="hint">点 3D 中的一段可直接扭转 · 拖动旋转视角</view>
  </block>
</view>
