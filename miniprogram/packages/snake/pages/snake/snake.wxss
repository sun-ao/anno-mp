.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(160deg, #eef3fb 0%, #f7f9fc 60%, #eef1f6 100%);
  box-sizing: border-box;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

/* 顶部模式切换 */
.tabs {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 32rpx 6rpx;
}
.tab {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5a6b80;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 42, 55, 0.08);
  transition: transform 0.12s ease, background 0.12s ease, color 0.12s ease;
}
.tab:active {
  transform: scale(0.98);
}
.tab.active {
  color: #ffffff;
  background: #2f6fb0;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(47, 111, 176, 0.3);
}

/* 段数切换 */
.seg-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 32rpx 6rpx;
}
.seg-label {
  font-size: 26rpx;
  color: #7a8699;
}
.seg-pill {
  min-width: 84rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #41566b;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 42, 55, 0.08);
  transition: transform 0.12s ease;
}
.seg-pill:active {
  transform: scale(0.96);
}
.seg-pill.active {
  color: #ffffff;
  background: #e8923a;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(232, 146, 58, 0.34);
}

.header {
  padding: 8rpx 32rpx 4rpx;
  text-align: center;
}
.shape-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2a37;
  line-height: 1.3;
}
.shape-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #7a8699;
}

.stage {
  flex: 1;
  position: relative;
  min-height: 0;
}
.stage-tools {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.zoom-tip {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(30, 41, 59, 0.82);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
  pointer-events: none;
  z-index: 6;
  animation: zoomTipIn 0.3s ease both;
}
@keyframes zoomTipIn {
  from { opacity: 0; transform: translateX(-50%) translateY(12rpx); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}
.tool-size {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 8rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(47, 111, 176, 0.18);
}
.size-label {
  font-size: 22rpx;
  color: #2f6fb0;
  min-width: 92rpx;
  text-align: center;
  white-space: nowrap;
}
.tool-toggle {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #2f6fb0;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(47, 111, 176, 0.18);
}
.tool-toggle.on {
  color: #ffffff;
  background: #2f6fb0;
}
.overlap-banner {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(226, 59, 59, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(226, 59, 59, 0.3);
}
/* 跟着折：方向提示横幅 */
.guide-banner {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 4rpx solid #ffe08a;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}
.dir-orb {
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.18);
  animation: orbBeat 0.9s ease-in-out infinite;
}
@keyframes orbBeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
.guide-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.guide-step {
  font-size: 22rpx;
  color: #8a94a6;
  font-weight: 600;
}
.guide-word {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a37;
  line-height: 1.3;
}
.guide-done {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 20rpx;
  background: rgba(76, 175, 80, 0.96);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.4);
  animation: popIn 0.4s ease;
}
.done-emoji {
  font-size: 44rpx;
}
@keyframes popIn {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.confetti {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 0;
  pointer-events: none;
  z-index: 5;
}
.cf {
  position: absolute;
  top: -10rpx;
  font-size: 46rpx;
  animation: fall 1.8s linear infinite;
}
.cf1 { left: 12%; animation-delay: 0s; }
.cf2 { left: 32%; animation-delay: 0.4s; }
.cf3 { left: 52%; animation-delay: 0.9s; }
.cf4 { left: 72%; animation-delay: 0.2s; }
.cf5 { left: 88%; animation-delay: 1.2s; }
@keyframes fall {
  0% { transform: translateY(-20rpx) rotate(0deg); opacity: 0; }
  15% { opacity: 1; }
  100% { transform: translateY(600rpx) rotate(360deg); opacity: 0; }
}

/* 跟着折：进度条 */
.guide-progress {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 28rpx 8rpx;
}
.prog-emoji {
  font-size: 30rpx;
  flex: 0 0 auto;
}
.guide-bar {
  flex: 1;
  height: 20rpx;
  background: #e3e9f1;
  border-radius: 12rpx;
  overflow: hidden;
}
.guide-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd54a, #f4b400);
  border-radius: 12rpx;
  transition: width 0.35s ease;
}
.guide-count {
  font-size: 26rpx;
  font-weight: 700;
  color: #e8923a;
  min-width: 70rpx;
  text-align: right;
}

/* 底部控制条 */
.control-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx 8rpx;
}
.control-bar.manual .ctrl-btn,
.control-bar.guide .ctrl-btn {
  font-size: 26rpx;
}
.ctrl-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2f6fb0;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(47, 111, 176, 0.12);
  transition: transform 0.12s ease, background 0.12s ease;
}
.ctrl-btn:active {
  transform: scale(0.97);
  background: #eaf1fb;
}
.ctrl-btn.primary {
  color: #ffffff;
  background: #2f6fb0;
  box-shadow: 0 4rpx 14rpx rgba(47, 111, 176, 0.32);
}
.ctrl-btn.primary:active {
  background: #2a629c;
}
.ctrl-btn.ghost {
  color: #e8923a;
  background: #fff6ec;
  box-shadow: 0 2rpx 8rpx rgba(232, 146, 58, 0.18);
}
.ctrl-btn.ghost.full {
  margin: 0 24rpx;
  padding: 0;
  flex: none;
}
.ctrl-btn.ghost:active {
  background: #fdecd9;
}

/* 倍速选择 */
.speed-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 4rpx 28rpx 8rpx;
}
.speed-label {
  font-size: 24rpx;
  color: #7a8699;
}
.speed-pill {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  color: #41566b;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(31, 42, 55, 0.08);
}
.speed-pill.active {
  color: #ffffff;
  background: #2f6fb0;
  font-weight: 600;
}

/* 造型 chips */
.preset-bar {
  white-space: nowrap;
  padding: 8rpx 16rpx calc(8rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.preset-chip {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  padding: 0 22rpx 0 26rpx;
  height: 64rpx;
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #41566b;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 42, 55, 0.08);
}
.preset-chip.active {
  color: #ffffff;
  background: #2f6fb0;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(47, 111, 176, 0.3);
}
.preset-name {
  line-height: 1.2;
}
.preset-chip.mine {
  background: #fff6ec;
  color: #9a5a1e;
}
.preset-chip.mine.active {
  background: #e8923a;
  color: #ffffff;
}
.mine-tag {
  display: inline-block;
  vertical-align: middle;
  padding: 0 14rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #9a5a1e;
}
.star {
  margin-left: 12rpx;
  font-size: 30rpx;
  line-height: 1;
  color: #c9a227;
}
.star.del {
  margin-left: 10rpx;
  color: #c0552f;
  font-size: 26rpx;
}

/* 关节轨道 */
.joint-rail {
  display: flex;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  overflow-x: scroll;
  white-space: nowrap;
  box-sizing: border-box;
}
.joint-dot {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #41566b;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(31, 42, 55, 0.1);
  transition: transform 0.12s ease;
}
.joint-dot.state-0 { color: #8aa0b8; }
.joint-dot.state-1 { background: #d8ead8; color: #2f7d4f; }
.joint-dot.state-2 { background: #f6e2c8; color: #b5762a; }
.joint-dot.state-3 { background: #f3d2cf; color: #c0552f; }
.joint-dot.sel {
  outline: 4rpx solid #2f6fb0;
  outline-offset: 2rpx;
  font-weight: 700;
}
.joint-dot:active {
  transform: scale(0.92);
}

/* 步进控制 */
.stepper {
  padding: 4rpx 24rpx 8rpx;
}
.stepper-title {
  display: block;
  font-size: 26rpx;
  color: #5a6b80;
  margin-bottom: 10rpx;
}
.stepper-btns {
  display: flex;
  gap: 14rpx;
}
.step-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2f6fb0;
  background: #ffffff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(47, 111, 176, 0.12);
  transition: transform 0.12s ease, background 0.12s ease;
}
.step-btn:active {
  transform: scale(0.97);
  background: #eaf1fb;
}

/* 姿态串 */
.pose-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 10rpx 24rpx 0;
  padding: 16rpx 22rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 42, 55, 0.08);
}
.pose-label {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: #7a8699;
}
.pose-digits {
  flex: 1;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #1f2a37;
  word-break: break-all;
}
.hint {
  padding: 12rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  color: #9aa6b5;
  text-align: center;
}
