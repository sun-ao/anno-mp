.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 24rpx;
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
}

.actions { display: flex; gap: 32rpx; }

.link {
  font-size: 28rpx;
  color: #3F51B5;
}

.link.danger { color: #E53935; }

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.thumb {
  width: 100%;
  height: 220rpx;
  background: #e9eaee;
}

.time {
  display: block;
  padding: 10rpx 12rpx;
  font-size: 20rpx;
  color: #888;
}

.del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-emoji { font-size: 96rpx; }
.empty-text { margin-top: 24rpx; color: #999; font-size: 28rpx; }

.go-btn {
  margin-top: 40rpx;
  background: #3F51B5;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 56rpx;
}
