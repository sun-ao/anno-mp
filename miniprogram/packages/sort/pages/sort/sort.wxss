.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF0F4 0%, #FBE2EC 100%);
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.counter {
  align-self: center;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 60rpx;
  padding: 12rpx 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(224, 101, 154, 0.18);
}

.counter-star {
  font-size: 44rpx;
}

.counter-num {
  margin-left: 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #E0659A;
}

.ball-area {
  position: relative;
  width: 100%;
  height: 400rpx;
  margin-top: 40rpx;
}

.ball {
  position: absolute;
  top: 40rpx;
  left: 50%;
  width: 160rpx;
  height: 160rpx;
  margin-left: -80rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.12), inset -10rpx -14rpx 0 rgba(0, 0, 0, 0.08);
  transition: left 0.5s cubic-bezier(0.45, 0, 1, 1), transform 0.5s cubic-bezier(0.45, 0, 1, 1), opacity 0.5s ease-in;
}

.ball::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 30rpx;
  width: 40rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
}

.ball-drop {
  transform: translateY(380rpx) scale(0.35);
  opacity: 0;
}

.ball-noanim {
  transition: none;
}

.basket-row {
  display: flex;
  width: 100%;
  margin-top: 20rpx;
}

.basket-cell {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 40rpx 0;
}

.basket {
  position: relative;
  width: 150rpx;
  height: 130rpx;
  border-radius: 24rpx 24rpx 40rpx 40rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.12);
}

.basket:active {
  transform: scale(0.93);
}

.basket-handle {
  position: absolute;
  top: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 84rpx;
  height: 46rpx;
  border: 12rpx solid rgba(255, 255, 255, 0.9);
  border-bottom: none;
  border-radius: 46rpx 46rpx 0 0;
  box-sizing: border-box;
}

.basket-mouth {
  position: absolute;
  top: 12rpx;
  left: 14rpx;
  right: 14rpx;
  height: 22rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.45);
}

.basket-shake {
  animation: basket-shake 0.4s ease;
}

@keyframes basket-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
