.page {
  min-height: 100vh;
  background: #f6f7f9;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx 24rpx 40rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 0;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.history-link {
  font-size: 28rpx;
  color: #0E8AC8;
}

.clock {
  margin: 36rpx 0 12rpx;
  text-align: center;
}

.time {
  font-size: 112rpx;
  font-weight: 700;
  color: #111;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}

.clock.running .time {
  color: #0E8AC8;
}

.clock-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.laps {
  flex: 1;
  margin-top: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.laps-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 4rpx;
  font-size: 26rpx;
  color: #888;
  border-bottom: 1rpx solid #f0f0f0;
}

.undo {
  color: #0E8AC8;
}

.lap-list {
  flex: 1;
}

.lap-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.lap-row.best .lap-total {
  color: #E2A100;
  font-weight: 700;
}

.lap-idx {
  font-size: 28rpx;
  color: #555;
  width: 150rpx;
}

.lap-split {
  font-size: 26rpx;
  color: #999;
  flex: 1;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.lap-total {
  font-size: 32rpx;
  color: #222;
  font-variant-numeric: tabular-nums;
}

.empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #aaa;
  font-size: 28rpx;
  text-align: center;
  padding: 40rpx;
  line-height: 1.8;
  white-space: pre-line;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  border-radius: 999rpx;
  font-size: 34rpx;
  padding: 28rpx 0;
  line-height: 1.2;
  border: none;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  flex: 1;
  background: #0E8AC8;
  color: #fff;
  font-weight: 600;
}

.btn-ghost {
  flex: 0 0 200rpx;
  background: #fff;
  color: #666;
  border: 1rpx solid #e2e2e2;
}
