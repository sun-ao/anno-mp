.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #C8E6C9 100%);
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #2E7D32;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #5C8A5E;
}

.counter {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2E7D32;
  background: #ffffff;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.item-card {
  margin-top: 48rpx;
  width: 320rpx;
  height: 320rpx;
  background: #ffffff;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.item-done {
  transform: scale(1.06);
  box-shadow: 0 12rpx 30rpx rgba(67, 160, 71, 0.35);
}

.item-emoji {
  font-size: 160rpx;
  line-height: 1;
}

.item-name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #444;
}

.bins {
  margin-top: 56rpx;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28rpx;
}

.bin {
  background: #ffffff;
  border: 6rpx solid #ccc;
  border-radius: 28rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.06);
}

.bin-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.bin-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.bin-shake {
  animation: binShake 0.4s ease;
}

@keyframes binShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  40% { transform: translateX(14rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

.tip {
  margin-top: 48rpx;
  font-size: 26rpx;
  color: #5C8A5E;
}

.score-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}
