<view class="page">
  <view class="title-area">
    <text class="title">彩色木琴</text>
    <text class="subtitle">点一点，听听声音</text>
  </view>

  <view class="xylo">
    <view
      wx:for="{{notes}}"
      wx:key="key"
      class="bar {{activeIndex === index ? 'bar-hit' : ''}}"
      style="background: {{item.color}}; height: {{360 - index * 16}}rpx;"
      data-idx="{{index}}"
      bindtap="onTapBar"
    >
      <text class="bar-label">{{item.label}}</text>
    </view>
  </view>

  <view class="song-btn {{playing ? 'song-btn-disabled' : ''}}" bindtap="onPlaySong">🎵 弹一首小星星</view>
</view>
