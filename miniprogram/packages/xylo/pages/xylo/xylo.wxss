.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8E9 0%, #FDF3E7 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #6B4A2B;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #B98A5A;
}

.xylo {
  margin-top: 60rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16rpx;
}

.bar {
  width: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 20rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.12);
  transform-origin: bottom center;
}

.bar-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.bar-hit {
  animation: barHit 0.3s ease;
}

@keyframes barHit {
  0% { transform: scaleY(1); }
  40% { transform: scaleY(0.88); filter: brightness(1.15); }
  100% { transform: scaleY(1); }
}

.song-btn {
  margin-top: 64rpx;
  padding: 26rpx 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFB347, #FF8C42);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(255, 140, 66, 0.4);
}

.song-btn:active {
  opacity: 0.85;
}

.song-btn-disabled {
  opacity: 0.5;
}
