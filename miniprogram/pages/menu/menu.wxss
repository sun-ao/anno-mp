.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #F6F7F9;
}

/* ===== 分类标题 ===== */
.sec-head {
  display: flex;
  align-items: center;
  margin: 40rpx 0 24rpx;
}

.sec-bar {
  width: 8rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: #185FA5;
  margin-right: 16rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2b2b2b;
}

.sec-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #fff;
  background: #b9bcc4;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

/* ===== 卡片网格 ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  position: relative;
  width: 331rpx;
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.card:active {
  transform: scale(0.97);
}

.card-disabled {
  opacity: 0.55;
}

.card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.card-icon-text {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 500;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888780;
  width: 100%;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #b4b2a9;
}
